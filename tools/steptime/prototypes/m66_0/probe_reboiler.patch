+
+#[allow(missing_docs)]
+pub mod probe6 {
+    use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+    pub static WARM_FAIL: AtomicUsize = AtomicUsize::new(0);
+    pub static CONT: AtomicUsize = AtomicUsize::new(0);
+    pub static COLD: AtomicUsize = AtomicUsize::new(0);
+    pub static HALVED: AtomicUsize = AtomicUsize::new(0);
+    pub static FALLBACK_OK: AtomicUsize = AtomicUsize::new(0);
+    pub static FALLBACK_FAIL: AtomicUsize = AtomicUsize::new(0);
+    pub static RUNNING: std::sync::Mutex<Option<f64>> = std::sync::Mutex::new(None);
+    pub static IN_FALLBACK: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    pub static SKIP_CONT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    pub static DECLINED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    pub fn running() -> Option<f64> { *RUNNING.lock().unwrap() }
+    pub fn fallbacks() -> [usize; 2] { [FALLBACK_OK.load(Relaxed), FALLBACK_FAIL.load(Relaxed)] }
+    pub fn counts() -> [usize; 4] {
+        [WARM_FAIL.load(Relaxed), CONT.load(Relaxed), COLD.load(Relaxed), HALVED.load(Relaxed)]
+    }
+}
