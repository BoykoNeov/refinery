+thread_local! { static PROBE_Q_LAST: std::cell::Cell<f64> = const { std::cell::Cell::new(0.0) }; }
+thread_local! { static PROBE_Q_TARGET: std::cell::Cell<f64> = const { std::cell::Cell::new(0.0) }; static PROBE_Q_START: std::cell::Cell<f64> = const { std::cell::Cell::new(f64::NAN) }; }
+thread_local! { static PROBE_CLAMP_BIT: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+const MW_W: f64 = 0.018015;
+const CP_V_W: f64 = 2000.0;
+const CP_L_W: f64 = 4184.0;
+const LAMBDA_100_W: f64 = 2.257e6;
+#[derive(Clone, Copy)]
+struct ProbeSteam {
+    mol: f64,
+    t_in: f64,
+}
+fn probe_steam() -> Option<ProbeSteam> {
+    let kg: f64 = std::env::var("PROBE_STEAM_KG_S").ok()?.parse().ok()?;
+    let c: f64 = std::env::var("PROBE_STEAM_C")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(400.0);
+    Some(ProbeSteam {
+        mol: kg / MW_W,
+        t_in: c + 273.15,
+    })
+}
+fn steam_h(t: f64) -> f64 {
+    MW_W * (CP_L_W * (373.15 - T_REF.value()) + LAMBDA_100_W + CP_V_W * (t - 373.15))
+}
+fn water_h(t: f64) -> f64 {
+    MW_W * CP_L_W * (t - T_REF.value())
+}
+fn water_tsat(p: f64) -> f64 {
+    1.0 / (1.0 / 373.15 - (8.314 / 40650.0) * (p / 101325.0).ln())
+}
+fn partial_pressures(p: f64, vapour: &[f64], steam: Option<ProbeSteam>) -> Vec<f64> {
+    vapour
+        .iter()
+        .map(|v| match steam {
+            Some(s) => p * v / (v + s.mol),
+            None => p,
+        })
+        .collect()
+}
+fn probe_bubble(
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    liquid: &[Vec<f64>],
+    pressures: &[f64],
+) -> Result<Vec<f64>, SimError> {
+    liquid
+        .iter()
+        .zip(pressures)
+        .map(|(x, p)| {
+            bubble_temperature_unnormalized(slate, thermo, x, Pascal(*p), "probe stage")
+                .map(|t| t.value())
+        })
+        .collect()
+}
+fn probe_k(
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    t: &[f64],
+    pressures: &[f64],
+) -> Result<Vec<Vec<f64>>, SimError> {
+    t.iter()
+        .zip(pressures)
+        .map(|(t, p)| {
+            (0..slate.len())
+                .map(|c| thermo.k_value(slate, c, Kelvin(*t), Pascal(*p)))
+                .collect()
+        })
+        .collect()
+}
