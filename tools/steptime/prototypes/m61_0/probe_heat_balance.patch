+/// PROBE: bottom-up from the steam, each stage's vapour and temperature solved
+/// together (its bubble point at the hydrocarbon partial pressure its own vapour
+/// sets). Returns the flows, the reflux ratio and the stage temperatures.
+#[allow(clippy::too_many_arguments)]
+fn probe_bottom_up(
+    plan: &CascadePlan,
+    state: &StageState<'_>,
+    feed_mass: f64,
+    feed_molar: f64,
+    feed_enthalpy: f64,
+    st: ProbeSteam,
+) -> Result<(Flows, f64, Vec<f64>), SimError> {
+    let slate = state.slate;
+    let thermo = state.thermo;
+    let n = plan.stages;
+    let last = state.draws.len() - 1;
+    let p = state.pressure.value();
+    let mut drawn = vec![0.0; n];
+    for (j, slot) in plan.draw_at_stage.iter().enumerate() {
+        if let Some(i) = slot {
+            drawn[j] = plan.mass_ratios[*i] * feed_mass / state.draws[*i].mean_molar_mass;
+        }
+    }
+    let _ = last;
+    let distillate = plan.mass_ratios[0] * feed_mass / state.draws[0].mean_molar_mass;
+    // reflux enthalpy from the iterate's stage-1 vapour
+    let condensate = equilibrium_vapour(&state.liquid[0], &state.k[0])?;
+    let condenser_t = bubble_temperature_unnormalized(slate, thermo, &condensate, state.pressure, "probe condenser")?;
+    let reflux_enthalpy = liquid_enthalpy(slate, &condensate, condenser_t);
+    let h_above = |j: usize| -> f64 {
+        if j == 0 {
+            reflux_enthalpy
+        } else {
+            liquid_enthalpy(slate, &state.liquid[j - 1], Kelvin(state.temperatures[j - 1]))
+        }
+    };
+    // stage j at hydrocarbon vapour v: (T, h_liquid, H_vapour)
+    let at = |j: usize, v: f64| -> Result<(f64, f64, f64), SimError> {
+        let php = p * v / (v + st.mol);
+        let t = bubble_temperature_unnormalized(slate, thermo, &state.liquid[j], Pascal(php), "probe stage")?;
+        let k: Vec<f64> = (0..slate.len())
+            .map(|c| thermo.k_value(slate, c, t, Pascal(php)))
+            .collect::<Result<_, _>>()?;
+        let y = equilibrium_vapour(&state.liquid[j], &k)?;
+        let h = liquid_enthalpy(slate, &state.liquid[j], t);
+        let big_h = liquid_enthalpy(slate, &y, t) + mixture_dh_vap(slate, thermo, &y, t)?;
+        Ok((t.value(), h, big_h))
+    };
+    let mut vapour = vec![0.0; n];
+    let mut temps = vec![0.0; n];
+    let mut liquid_down = vec![0.0; n]; // L_j leaving stage j downward (0 at bottom)
+    let mut liquid_in = vec![0.0; n]; // L_{j-1}
+    // what arrives from below stage j
+    let mut v_below = 0.0;
+    let mut big_h_below = 0.0;
+    let mut steam_h_below = steam_h(st.t_in);
+    let mut l_here = 0.0; // L_j leaving downward
+    for j in (0..n).rev() {
+        let u = drawn[j];
+        let f = if j == plan.feed_stage { feed_molar } else { 0.0 };
+        let q = plan.side_heat[j];
+        let ha = h_above(j);
+        let g = |v: f64| -> Result<f64, SimError> {
+            let (t, h, big_h) = at(j, v)?;
+            let rhs = (l_here + u) * (ha - h) + v_below * (big_h_below - ha) + f * (feed_enthalpy - ha)
+                + st.mol * (steam_h_below - steam_h(t))
+                - q;
+            Ok(v * (big_h - ha) - rhs)
+        };
+        let (mut lo, mut hi) = ((1.0e-7 * st.mol).ln(), (50.0 * feed_molar).ln());
+        let g_lo = g(lo.exp())?;
+        let g_hi = g(hi.exp())?;
+        if g_lo > 0.0 || g_hi < 0.0 {
+            for v in [lo.exp(), (1.0e-3 * st.mol), st.mol, 0.1 * feed_molar, feed_molar, hi.exp()] {
+                let (t, h, big_h) = at(j, v)?;
+                eprintln!("PROBE dbg stage {} v={v:.3e} T={:.1}C h={h:.4e} H={big_h:.4e} ha={ha:.4e} g={:.4e}", j + 1, t - 273.15, g(v)?);
+            }
+            return Err(SimError::Numerical(format!(
+                "PROBE bottom-up: stage {} has no vapour root (g(lo) {g_lo:.4e}, g(hi) {g_hi:.4e}); L_down {l_here:.3e} V_below {v_below:.3e}",
+                j + 1
+            )));
+        }
+        for _ in 0..60 {
+            let mid = 0.5 * (lo + hi);
+            if g(mid.exp())? < 0.0 {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        let v = (0.5 * (lo + hi)).exp();
+        let (t, _, big_h) = at(j, v)?;
+        vapour[j] = v;
+        temps[j] = t;
+        liquid_down[j] = l_here;
+        // L_{j-1} = L_j + U_j + V_j - V_{j+1} - F_j
+        let l_above = l_here + u + v - v_below - f;
+        liquid_in[j] = l_above;
+        if !(l_above >= 0.0) {
+            return Err(SimError::Numerical(format!(
+                "PROBE bottom-up: the liquid onto stage {} is {l_above:.4e} mol/s",
+                j + 1
+            )));
+        }
+        l_here = l_above;
+        v_below = v;
+        big_h_below = big_h;
+        steam_h_below = steam_h(t);
+    }
+    let reflux = liquid_in[0];
+    let reflux_ratio = reflux / distillate;
+    liquid_down[n - 1] = 0.0;
+    Ok((
+        Flows {
+            liquid_in,
+            liquid_down,
+            liquid_drawn: drawn,
+            vapour,
+            reflux,
+        },
+        reflux_ratio,
+        temps,
+    ))
+}
+
+/// PROBE (M61.0): the heat-balance cascade's equations solved by Newton on every
+/// stage temperature, every vapour rate below the top and every molar draw rate
+/// but the bottoms at once (Tomich's 2N arrangement, with the draws added): the
+/// compositions from the Thomas sweeps at those flows, the residuals the
+/// summation `Σ K·x − 1` per stage, each stage's energy balance but the
+/// reboiler's, and each draw's mass ratio. No vapour floor.
+pub(crate) struct NewtonOut {
+    pub(crate) t: Vec<f64>,
+    pub(crate) v: Vec<f64>,
+    pub(crate) liquid: Vec<Vec<f64>>,
+    pub(crate) flows: Flows,
+    pub(crate) iterations: u32,
+    pub(crate) norm: f64,
+    pub(crate) reflux_ratio: f64,
+}
+
+#[allow(clippy::too_many_arguments)]
+fn newton_residual(
+    plan: &CascadePlan,
+    spec: &CascadeSpec,
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    pressure: Pascal,
+    feed: &MoleFractions,
+    feed_mass: f64,
+    feed_molar: f64,
+    feed_enthalpy: f64,
+    u: &[f64],
+) -> Result<Vec<f64>, SimError> {
+    newton_residual_full(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, u).map(|x| x.0)
+}
+
+#[allow(clippy::too_many_arguments)]
+#[derive(Clone, Copy)]
+pub(crate) enum SpecMode {
+    Reflux,
+    Floor(usize),
+    Reboiler(f64),
+}
+
+pub(crate) fn spec_mode() -> SpecMode {
+    match std::env::var("PROBE_SPEC").ok() {
+        Some(v) if v.starts_with("floor:") => SpecMode::Floor(v[6..].parse().unwrap()),
+        Some(v) if v.starts_with("reb:") => SpecMode::Reboiler(v[4..].parse::<f64>().unwrap() * 1e6),
+        _ => SpecMode::Reflux,
+    }
+}
+
+thread_local! { pub(crate) static PROBE_MODE: std::cell::Cell<Option<SpecMode>> = const { std::cell::Cell::new(None) }; }
+
+fn newton_residual_full(
+    plan: &CascadePlan,
+    spec: &CascadeSpec,
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    pressure: Pascal,
+    feed: &MoleFractions,
+    feed_mass: f64,
+    feed_molar: f64,
+    feed_enthalpy: f64,
+    u: &[f64],
+) -> Result<(Vec<f64>, Vec<Vec<f64>>, Flows), SimError> {
+    let n = plan.stages;
+    let ndraw = plan.mass_ratios.len() - 1; // all but the bottoms
+    let t = &u[0..n];
+    let mut rates = vec![0.0; ndraw];
+    rates.copy_from_slice(&u[2 * n - 1..2 * n - 1 + ndraw]);
+    if t.iter().any(|x| !x.is_finite() || *x <= 100.0) || rates.iter().any(|r| !(*r > 0.0)) {
+        return Err(SimError::Numerical("newton: iterate out of range".into()));
+    }
+    let distillate = rates[0];
+    let mode = PROBE_MODE.with(|m| m.get()).unwrap_or(SpecMode::Reflux);
+    let reflux_ratio = match mode {
+        SpecMode::Reflux => spec.reflux_ratio,
+        _ => u[u.len() - 1],
+    };
+    if !(reflux_ratio > 0.0) {
+        return Err(SimError::Numerical("newton: non-positive reflux".into()));
+    }
+    let mut vapour = vec![0.0; n];
+    vapour[0] = (reflux_ratio + 1.0) * distillate;
+    vapour[1..n].copy_from_slice(&u[n..2 * n - 1]);
+    if vapour.iter().any(|v| !(*v > 0.0)) {
+        return Err(SimError::Numerical("newton: non-positive vapour".into()));
+    }
+    let mut drawn = vec![0.0; n];
+    for (j, slot) in plan.draw_at_stage.iter().enumerate() {
+        if let Some(i) = slot {
+            if *i < ndraw && *i > 0 {
+                drawn[j] = rates[*i];
+            }
+        }
+    }
+    let reflux = reflux_ratio * distillate;
+    let mut liquid_in = vec![0.0; n];
+    let mut liquid_down = vec![0.0; n];
+    liquid_in[0] = reflux;
+    for j in 0..n - 1 {
+        let f = if j == plan.feed_stage { feed_molar } else { 0.0 };
+        liquid_down[j] = liquid_in[j] + vapour[j + 1] + f - drawn[j] - vapour[j];
+        liquid_in[j + 1] = liquid_down[j];
+    }
+    let f_last = if n - 1 == plan.feed_stage { feed_molar } else { 0.0 };
+    let bottoms = liquid_in[n - 1] + f_last - vapour[n - 1];
+    if liquid_down[..n - 1].iter().any(|l| !(*l >= 0.0)) || !(bottoms > 0.0) {
+        return Err(SimError::Numerical("newton: a liquid went negative".into()));
+    }
+    drawn[n - 1] = bottoms;
+    liquid_down[n - 1] = 0.0;
+    let flows = Flows {
+        liquid_in: liquid_in.clone(),
+        liquid_down: liquid_down.clone(),
+        liquid_drawn: drawn.clone(),
+        vapour: vapour.clone(),
+        reflux,
+    };
+    let k: Vec<Vec<f64>> = t
+        .iter()
+        .map(|tj| {
+            (0..slate.len())
+                .map(|c| thermo.k_value(slate, c, Kelvin(*tj), pressure))
+                .collect::<Result<Vec<f64>, _>>()
+        })
+        .collect::<Result<_, _>>()?;
+    let mut amounts = vec![vec![0.0; slate.len()]; n];
+    for c in 0..slate.len() {
+        let col = plan.solve_component(&flows, &k, c, feed.fractions()[c], feed_molar)?;
+        for j in 0..n {
+            amounts[j][c] = col[j];
+        }
+    }
+    let mut r = Vec::with_capacity(2 * n - 1 + ndraw);
+    // summation, one per stage
+    for j in 0..n {
+        let sum: f64 = amounts[j].iter().zip(&k[j]).map(|(x, k)| x * k).sum();
+        r.push(sum - 1.0);
+    }
+    let liquid: Vec<Vec<f64>> = amounts
+        .iter()
+        .map(|a| MoleFractions::from_amounts(a).map(|m| m.fractions().to_vec()))
+        .collect::<Result<_, _>>()?;
+    let mut h = Vec::with_capacity(n);
+    let mut big_h = Vec::with_capacity(n);
+    for j in 0..n {
+        let y = equilibrium_vapour(&liquid[j], &k[j])?;
+        h.push(liquid_enthalpy(slate, &liquid[j], Kelvin(t[j])));
+        big_h.push(liquid_enthalpy(slate, &y, Kelvin(t[j])) + mixture_dh_vap(slate, thermo, &y, Kelvin(t[j]))?);
+    }
+    let condensate = equilibrium_vapour(&liquid[0], &k[0])?;
+    let condenser_t = bubble_temperature_unnormalized(slate, thermo, &condensate, pressure, "newton condenser")?;
+    let h_reflux = liquid_enthalpy(slate, &condensate, condenser_t);
+    let energy_scale = feed_molar * 1.0e4;
+    for j in 0..n - 1 {
+        let f = if j == plan.feed_stage { feed_molar } else { 0.0 };
+        let above = if j == 0 { h_reflux } else { h[j - 1] };
+        let e = liquid_in[j] * above + vapour[j + 1] * big_h[j + 1] + f * feed_enthalpy
+            - (liquid_down[j] + drawn[j]) * h[j]
+            - vapour[j] * big_h[j]
+            - plan.side_heat[j];
+        r.push(e / energy_scale);
+    }
+    // each draw's mass ratio: U·M̄ = ratio·F
+    for (i, rate) in rates.iter().enumerate() {
+        let comp: Vec<f64> = match plan.locations[i] {
+            DrawLocation::Condenser => condensate.clone(),
+            DrawLocation::Stage(j) => liquid[j].clone(),
+        };
+        let m: f64 = comp.iter().enumerate().map(|(c, x)| x * slate.get(c).molar_mass.value()).sum();
+        r.push((rate * m - plan.mass_ratios[i] * feed_mass) / feed_mass);
+    }
+    match mode {
+        SpecMode::Reflux => {}
+        SpecMode::Floor(j) => r.push((vapour[j] - VAPOUR_FLOOR_OF_FEED * feed_molar) / feed_molar),
+        SpecMode::Reboiler(q) => {
+            let last = n - 1;
+            let f = if last == plan.feed_stage { feed_molar } else { 0.0 };
+            let e = liquid_in[last] * h[last - 1] + f * feed_enthalpy + q
+                - drawn[last] * h[last]
+                - vapour[last] * big_h[last];
+            r.push(e / energy_scale);
+        }
+    }
+    Ok((r, liquid, flows))
+}
+
+fn solve_dense(mut a: Vec<Vec<f64>>, mut b: Vec<f64>) -> Option<Vec<f64>> {
+    let n = b.len();
+    for col in 0..n {
+        let piv = (col..n).max_by(|i, j| a[*i][col].abs().total_cmp(&a[*j][col].abs()))?;
+        if a[piv][col].abs() < 1e-300 {
+            return None;
+        }
+        a.swap(col, piv);
+        b.swap(col, piv);
+        for row in col + 1..n {
+            let f = a[row][col] / a[col][col];
+            if f != 0.0 {
+                for c in col..n {
+                    a[row][c] -= f * a[col][c];
+                }
+                b[row] -= f * b[col];
+            }
+        }
+    }
+    let mut x = vec![0.0; n];
+    for row in (0..n).rev() {
+        let mut acc = b[row];
+        for c in row + 1..n {
+            acc -= a[row][c] * x[c];
+        }
+        x[row] = acc / a[row][row];
+    }
+    x.iter().all(|v| v.is_finite()).then_some(x)
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn newton_solve(
+    plan: &CascadePlan,
+    spec: &CascadeSpec,
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    pressure: Pascal,
+    feed: &MoleFractions,
+    feed_mass: f64,
+    feed_molar: f64,
+    feed_enthalpy: f64,
+    t0: &[f64],
+    v0: &[f64],
+    rates0: &[f64],
+) -> Result<NewtonOut, SimError> {
+    let requested = std::env::var("PROBE_SPEC").ok();
+    if requested.as_deref() != Some("auto") {
+        return newton_solve_mode(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, t0, v0, rates0, spec_mode());
+    }
+    let floor = VAPOUR_FLOOR_OF_FEED * feed_molar;
+    let n = plan.stages;
+    // a warm start that ran above its declared reflux tries the floor first, on the stage it bound
+    let seed_r = v0[0] / rates0[0] - 1.0;
+    if seed_r > spec.reflux_ratio * (1.0 + 1.0e-6) {
+        let binding = (1..n).min_by(|a, b| v0[*a].total_cmp(&v0[*b])).unwrap();
+        if let Ok(out) = newton_solve_mode(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, t0, v0, rates0, SpecMode::Floor(binding)) {
+            if out.reflux_ratio >= spec.reflux_ratio && out.v[1..].iter().all(|v| *v >= floor * (1.0 - 1.0e-9)) {
+                return Ok(out);
+            }
+        }
+    }
+    let first = newton_solve_mode(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, t0, v0, rates0, SpecMode::Reflux);
+    let mut binding = match &first {
+        Ok(out) if out.v[1..].iter().all(|v| *v >= floor) => return first,
+        Ok(out) => (1..n).min_by(|a, b| out.v[*a].total_cmp(&out.v[*b])).unwrap(),
+        Err(_) => (1..n).min_by(|a, b| v0[*a].total_cmp(&v0[*b])).unwrap(),
+    };
+    for _ in 0..n {
+        let out = newton_solve_mode(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, t0, v0, rates0, SpecMode::Floor(binding))?;
+        match (1..n).find(|j| out.v[*j] < floor * (1.0 - 1.0e-9)) {
+            None => {
+                if std::env::var("PROBE_PRINT").is_ok() {
+                    eprintln!("PROBE floor active on vapour index {binding}, reflux {:.4}", out.reflux_ratio);
+                }
+                return Ok(out);
+            }
+            Some(j) => binding = j,
+        }
+    }
+    Err(SimError::Numerical("newton: the floor's active set did not settle".into()))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn newton_solve_mode(
+    plan: &CascadePlan,
+    spec: &CascadeSpec,
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    pressure: Pascal,
+    feed: &MoleFractions,
+    feed_mass: f64,
+    feed_molar: f64,
+    feed_enthalpy: f64,
+    t0: &[f64],
+    v0: &[f64],
+    rates0: &[f64],
+    mode: SpecMode,
+) -> Result<NewtonOut, SimError> {
+    let n = plan.stages;
+    PROBE_MODE.with(|m| m.set(Some(mode)));
+    let mut u: Vec<f64> = t0.to_vec();
+    u.extend_from_slice(&v0[1..n]);
+    u.extend_from_slice(rates0);
+    if !matches!(mode, SpecMode::Reflux) {
+        let r0 = (v0[0] / rates0[0] - 1.0).max(spec.reflux_ratio);
+        u.push(r0);
+    }
+    let f = |u: &[f64]| newton_residual(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, u);
+    let norm = |r: &[f64]| r.iter().map(|x| x * x).sum::<f64>().sqrt();
+    let mut r = f(&u)?;
+    let mut nr = norm(&r);
+    if std::env::var("PROBE_NEWTON_TRACE").is_ok() {
+        eprintln!("PROBE newton start r=[{}] u_tail={:?}", r.iter().map(|x| format!("{x:.2e}")).collect::<Vec<_>>().join(","), &u[u.len()-6..]);
+    }
+    let max_it: u32 = std::env::var("PROBE_NEWTON_MAX").ok().and_then(|v| v.parse().ok()).unwrap_or(60);
+    let mut it = 0;
+    while nr > 1.0e-11 && it < max_it {
+        it += 1;
+        let m = u.len();
+        let mut jac = vec![vec![0.0; m]; m];
+        for col in 0..m {
+            let step = if col < n { 1.0e-4 } else { 1.0e-7 * u[col].abs().max(1.0e-3) };
+            let mut up = u.clone();
+            up[col] += step;
+            let rp = match f(&up) {
+                Ok(rp) => rp,
+                Err(_) => {
+                    up[col] = u[col] - step;
+                    let rm = f(&up)?;
+                    for row in 0..m {
+                        jac[row][col] = (r[row] - rm[row]) / step;
+                    }
+                    continue;
+                }
+            };
+            for row in 0..m {
+                jac[row][col] = (rp[row] - r[row]) / step;
+            }
+        }
+        let neg: Vec<f64> = r.iter().map(|x| -x).collect();
+        let du = solve_dense(jac, neg).ok_or_else(|| SimError::Numerical("newton: singular Jacobian".into()))?;
+        // limit the temperature move to 25 K and keep flows positive
+        let mut scale = 1.0f64;
+        for j in 0..n {
+            if du[j].abs() > 25.0 {
+                scale = scale.min(25.0 / du[j].abs());
+            }
+        }
+        for col in n..m {
+            if u[col] + scale * du[col] <= 0.0 {
+                scale = scale.min(0.9 * u[col] / (-du[col]));
+            }
+        }
+        let mut accepted = false;
+        for _ in 0..30 {
+            let trial: Vec<f64> = u.iter().zip(&du).map(|(a, d)| a + scale * d).collect();
+            if let Ok(rt) = f(&trial) {
+                let nt = norm(&rt);
+                if nt < nr * (1.0 - 1.0e-4 * scale) || nt < 1.0e-11 {
+                    u = trial;
+                    r = rt;
+                    nr = nt;
+                    accepted = true;
+                    break;
+                }
+            }
+            scale *= 0.5;
+        }
+        if std::env::var("PROBE_NEWTON_TRACE").is_ok() {
+            eprintln!("PROBE newton it={it} norm={nr:.3e} scale={scale:.3e}");
+        }
+        if !accepted {
+            // where the iterate sits: the worst residual, the smallest vapour, the reboiler closure
+            let (worst, wv) = r.iter().enumerate().fold((0, 0.0f64), |acc, (i, x)| if x.abs() > acc.1 { (i, x.abs()) } else { acc });
+            let vmin = u[n..2 * n - 1].iter().cloned().fold(f64::INFINITY, f64::min);
+            let kind = if worst < n { format!("summation on stage {}", worst + 1) } else if worst < 2 * n - 1 { format!("energy on stage {}", worst - n + 1) } else { format!("draw {}", worst - (2 * n - 1)) };
+            let v_str = u[n..2 * n - 1].iter().map(|v| format!("{v:.0}")).collect::<Vec<_>>().join(",");
+            let t_str = u[0..n].iter().map(|t| format!("{:.0}", t - 273.15)).collect::<Vec<_>>().join(",");
+            let l_str = match newton_residual_full(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, &u) {
+                Ok((_, _, fl)) => fl.liquid_down.iter().map(|l| format!("{l:.0}")).collect::<Vec<_>>().join(",") + &format!(" reflux {:.0} drawn [{}]", fl.reflux, fl.liquid_drawn.iter().map(|l| format!("{l:.0}")).collect::<Vec<_>>().join(",")),
+                Err(e) => format!("({e})"),
+            };
+            return Err(SimError::Numerical(format!("newton: no descent at iteration {it}, norm {nr:.3e}; worst {kind} ({wv:.2e}); V=[{v_str}] (min {vmin:.1}) T=[{t_str}] L_down=[{l_str}]")));
+        }
+    }
+    if nr > 1.0e-11 {
+        return Err(SimError::Numerical(format!("newton: not converged in {it} iterations, norm {nr:.3e}")));
+    }
+    let solved_r = match mode {
+        SpecMode::Reflux => spec.reflux_ratio,
+        _ => u[u.len() - 1],
+    };
+    let mut v = vec![(solved_r + 1.0) * u[2 * n - 1]];
+    v.extend_from_slice(&u[n..2 * n - 1]);
+    let (_, liquid, flows) = newton_residual_full(plan, spec, slate, thermo, pressure, feed, feed_mass, feed_molar, feed_enthalpy, &u)?;
+    Ok(NewtonOut { t: u[0..n].to_vec(), v, liquid, flows, iterations: it, norm: nr, reflux_ratio: solved_r })
+}
+
 /// What one iteration's stage balances read: the profile as it stands.
