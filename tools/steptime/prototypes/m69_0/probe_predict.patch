@@ -0,0 +1,272 @@
+//! M69.0 probe (A29): a coil plant's tick - its re-solves, and where the time
+//! goes: the flow solve, the resolve (the coil's cells, the column), the line
+//! flash. Shares and counts; the machine is loaded.
+//!
+//! cargo run --release --bin m69_0_count -- <scenarios dir> [plant ...]
+//!   DUMP=<dir>  one CSV per plant, a row per tick
+
+use refinery_core::snapshot::{Command, Snapshot};
+use refinery_core::units::Watt;
+use refinery_core::Engine;
+use refinery_solvers::probe::{self, Counters, SECTIONS};
+use std::time::Instant;
+
+enum Beat {
+    Run(u32),
+    Reflux(f64),
+    Pumparounds([f64; 3]),
+    Furnace(f64),
+    Valve(&'static str, f64),
+    /// The cold start-up of `crude_unit_cold_reference.rs`.
+    ColdStartUp,
+}
+
+fn build(path: &str) -> Engine {
+    let src = std::fs::read_to_string(path).unwrap_or_else(|e| panic!("{path}: {e}"));
+    let file = refinery_scenarios::load_str(&src).expect("parse");
+    refinery_scenarios::build_engine(&file).expect("build")
+}
+
+fn reboiler_w(s: &Snapshot) -> f64 {
+    s.nodes
+        .iter()
+        .find(|n| n.name == "column")
+        .unwrap()
+        .column_duty
+        .as_ref()
+        .unwrap()
+        .reboiler_w
+}
+
+struct Tick {
+    wall_ns: u64,
+    c: Counters,
+    t: std::collections::BTreeMap<&'static str, (u64, u64)>,
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let dir = args.get(1).cloned().unwrap_or_else(|| "scenarios".into());
+    let only: Vec<String> = args[2.min(args.len())..].to_vec();
+    let dump = std::env::var("DUMP").ok();
+    use Beat::*;
+    // Held from the file, then the furnace stepped as the screen's key does.
+    let boiling = vec![Run(1000), Furnace(25.0), Run(1500)];
+    let stripped = vec![Run(1000), Furnace(65.0), Run(1500)];
+    let steady = vec![Run(1500)];
+    let cold = vec![ColdStartUp];
+    let plants: Vec<(&str, &Vec<Beat>)> = vec![
+        ("crude_unit_boiling", &boiling),
+        ("crude_unit_stripped", &stripped),
+        ("crude_unit_cold", &cold),
+        ("crude_unit_wet", &steady),
+        ("crude_unit", &steady),
+    ];
+    for (name, beats) in plants {
+        if !only.is_empty() && !only.iter().any(|o| o == name) {
+            continue;
+        }
+        let mut engine = build(&format!("{dir}/{name}.toml"));
+        let engine_name = name;
+        let column = engine.graph.find_node("column").expect("a column");
+        let mut ticks: Vec<Tick> = Vec::new();
+        probe::take();
+        refinery_core::probe::take();
+        let mut beat_ticks = Vec::new();
+        let mut pass_log: Vec<Vec<(f64, std::collections::BTreeMap<&'static str, u64>)>> =
+            Vec::new();
+        let mut tick = |engine: &mut Engine, ticks: &mut Vec<Tick>| {
+            probe::clear_flash_keys();
+            let start = Instant::now();
+            engine.tick().expect("a story's tick");
+            let wall_ns = start.elapsed().as_nanos() as u64;
+            ticks.push(Tick {
+                wall_ns,
+                c: probe::take(),
+                t: refinery_core::probe::take(),
+            });
+            pass_log.push(refinery_core::probe::take_passes());
+            if let Ok(d) = std::env::var("SNAPDIR") {
+                let t = ticks.len();
+                if [1000usize, 1002, 1010, 1100, 1500, 2000, 2400, 2500].contains(&t) {
+                    std::fs::write(
+                        format!("{d}/{}_{t}.json", engine_name),
+                        serde_json::to_string(&engine.snapshot()).unwrap(),
+                    )
+                    .unwrap();
+                }
+            }
+        };
+        for beat in beats {
+            let command = match *beat {
+                Run(n) => {
+                    for _ in 0..n {
+                        tick(&mut engine, &mut ticks);
+                    }
+                    continue;
+                }
+                Reflux(r) => vec![Command::SetRefluxRatio {
+                    node: column,
+                    reflux_ratio: r,
+                }],
+                Pumparounds(d) => (0..3)
+                    .map(|i| Command::SetPumparoundDuty {
+                        node: column,
+                        pumparound: i,
+                        duty: Watt(d[i as usize] * 1e6),
+                    })
+                    .collect(),
+                Furnace(mw) => vec![Command::SetFurnaceDuty {
+                    node: engine.graph.find_node("furnace").unwrap(),
+                    duty: Watt(mw * 1e6),
+                }],
+                Valve(v, o) => vec![Command::SetValveOpening {
+                    node: engine.graph.find_node(v).unwrap(),
+                    opening: o,
+                }],
+                ColdStartUp => {
+                    let furnace = engine.graph.find_node("furnace").unwrap();
+                    for t in 1..=2_400u64 {
+                        if t == 10 {
+                            engine
+                                .apply(Command::SetFurnaceDuty {
+                                    node: furnace,
+                                    duty: Watt(58.0e6),
+                                })
+                                .unwrap();
+                        }
+                        if t == 500 {
+                            for pumparound in 0..3 {
+                                engine
+                                    .apply(Command::SetPumparoundDuty {
+                                        node: column,
+                                        pumparound,
+                                        duty: Watt::ZERO,
+                                    })
+                                    .unwrap();
+                            }
+                        }
+                        if t >= 500 && t % 10 == 0 {
+                            let running = reboiler_w(&engine.snapshot());
+                            if running > 0.0 {
+                                engine
+                                    .apply(Command::SetReboilerDuty {
+                                        node: column,
+                                        duty: Some(Watt((running - 2.5e6).max(0.0))),
+                                    })
+                                    .unwrap();
+                            }
+                        }
+                        tick(&mut engine, &mut ticks);
+                    }
+                    continue;
+                }
+            };
+            beat_ticks.push(ticks.len() + 1);
+            for c in command {
+                let _ = engine.apply(c);
+            }
+        }
+        let split = beat_ticks.first().copied().unwrap_or(ticks.len() + 1);
+        // Passes of a few ticks, one line each.
+        let sample: Vec<usize> = [2usize, 500, split, split + 1, split + 2, split + 10, split + 300]
+            .into_iter()
+            .filter(|t| *t <= ticks.len())
+            .collect();
+        for t in sample {
+            let passes = &pass_log[t - 1];
+            let mut line = format!("  {name} tick {t}:");
+            let mut prior: std::collections::BTreeMap<&str, u64> = Default::default();
+            for (change, counts) in passes {
+                let d = |k: &str| counts.get(k).copied().unwrap_or(0) - prior.get(k).copied().unwrap_or(0);
+                line.push_str(&format!(
+                    " [chg {change:.1e} it {} dens {} (rep {}/{}) settle {} (rep {}/{})]",
+                    d("engine: flow iterations"),
+                    d("flash: density"),
+                    d("flash: density repeat (same)"),
+                    d("flash: density repeat (any)"),
+                    d("flash: settle"),
+                    d("flash: settle repeat (same)"),
+                    d("flash: settle repeat (any)"),
+                ));
+                prior = counts.iter().map(|(k, v)| (*k, *v)).collect();
+            }
+            println!("{line}");
+        }
+        // Reported in two windows: held (before the first beat), and after it.
+        report(name, "held", &ticks[1..(split - 1).min(ticks.len())]);
+        if split <= ticks.len() {
+            report(name, "after the step", &ticks[split - 1..]);
+        }
+        if let Some(d) = &dump {
+            let mut text = String::from(
+                "tick,wall_us,passes,flow_iterations,flow_us,resolve_us,coil_us,settle_n,settle_us,density_n,density_us,column_n,column_us\n",
+            );
+            for (i, t) in ticks.iter().enumerate() {
+                let g = |n: &str| t.t.get(n).copied().unwrap_or((0, 0));
+                text.push_str(&format!(
+                    "{},{:.1},{},{},{:.1},{:.1},{:.1},{},{:.1},{},{:.1},{},{:.1}\n",
+                    i + 1,
+                    t.wall_ns as f64 / 1e3,
+                    g("engine: flow solve").0,
+                    g("engine: flow iterations").0,
+                    g("engine: flow solve").1 as f64 / 1e3,
+                    g("engine: resolve").1 as f64 / 1e3,
+                    g("resolve: coil cells").1 as f64 / 1e3,
+                    g("flash: settle").0,
+                    g("flash: settle").1 as f64 / 1e3,
+                    g("flash: density").0,
+                    g("flash: density").1 as f64 / 1e3,
+                    g("column: separate").0,
+                    t.c.ns[13] as f64 / 1e3,
+                ));
+            }
+            std::fs::write(format!("{d}/{name}.csv"), text).unwrap();
+        }
+    }
+}
+
+fn report(name: &str, window: &str, ticks: &[Tick]) {
+    if ticks.is_empty() {
+        return;
+    }
+    let n = ticks.len() as f64;
+    let wall: f64 = ticks.iter().map(|t| t.wall_ns as f64).sum();
+    let mut all: std::collections::BTreeMap<&str, (u64, u64)> = Default::default();
+    for t in ticks {
+        for (k, v) in &t.t {
+            let e = all.entry(k).or_insert((0, 0));
+            e.0 += v.0;
+            e.1 += v.1;
+        }
+    }
+    let column_ns: f64 = ticks.iter().map(|t| t.c.ns[13] as f64).sum();
+    let jac_ns: f64 = ticks.iter().map(|t| t.c.ns[10] as f64).sum();
+    let mut passes: Vec<u64> = ticks
+        .iter()
+        .map(|t| t.t.get("engine: flow solve").map_or(0, |v| v.0))
+        .collect();
+    passes.sort_unstable();
+    println!(
+        "== {name} [{window}] {} ticks: wall mean {:.2} ms; passes/tick mean {:.2} median {} max {}",
+        ticks.len(),
+        wall / n / 1e6,
+        passes.iter().sum::<u64>() as f64 / n,
+        passes[passes.len() / 2],
+        passes[passes.len() - 1]
+    );
+    for (k, (count, ns)) in &all {
+        println!(
+            "    {k:26} {:9.2}/tick  {:5.1} % of wall",
+            *count as f64 / n,
+            100.0 * *ns as f64 / wall
+        );
+    }
+    println!(
+        "    {:26} {:9}       {:5.1} % of wall (jacobian {:.1} %)",
+        "column (separate, all)",
+        "",
+        100.0 * column_ns / wall,
+        100.0 * jac_ns / wall
+    );
+}
