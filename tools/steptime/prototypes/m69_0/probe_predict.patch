new file mode 100644
index 0000000..dbea186
--- /dev/null
+++ b/tools/steptime/src/bin/m68_0_count.rs
@@ -0,0 +1,273 @@
+//! M68.0 probe: the column solve's work per tick through each column plant's
+//! story — solves, Newton iterations, evaluations by caller, and where the
+//! time inside them goes (shares only; the machine is loaded).
+//!
+//! cargo run --release --bin m68_0_count -- <scenarios dir> [plant ...]
+//!   DUMP=<dir>  one CSV per plant, a row per tick
+
+use refinery_core::snapshot::{Command, Snapshot};
+use refinery_core::units::Watt;
+use refinery_core::Engine;
+use refinery_solvers::probe::{self, Counters, SECTIONS};
+use std::time::Instant;
+
+enum Beat {
+    Run(u32),
+    Reflux(f64),
+    Pumparounds([f64; 3]),
+    Furnace(f64),
+    Valve(&'static str, f64),
+    /// The cold start-up of `crude_unit_cold_reference.rs`.
+    ColdStartUp,
+}
+
+fn build(path: &str) -> Engine {
+    let src = std::fs::read_to_string(path).unwrap_or_else(|e| panic!("{path}: {e}"));
+    let file = refinery_scenarios::load_str(&src).expect("parse");
+    refinery_scenarios::build_engine(&file).expect("build")
+}
+
+fn reboiler_w(s: &Snapshot) -> f64 {
+    s.nodes
+        .iter()
+        .find(|n| n.name == "column")
+        .unwrap()
+        .column_duty
+        .as_ref()
+        .unwrap()
+        .reboiler_w
+}
+
+struct Tick {
+    wall_ns: u64,
+    c: Counters,
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let dir = args.get(1).cloned().unwrap_or_else(|| "scenarios".into());
+    let only: Vec<String> = args[2.min(args.len())..].to_vec();
+    let dump = std::env::var("DUMP").ok();
+    use Beat::*;
+    let crude = vec![
+        Run(1000),
+        Reflux(2.0),
+        Run(300),
+        Reflux(4.0),
+        Run(300),
+        Pumparounds([0.0; 3]),
+        Run(300),
+        Reflux(8.0),
+        Run(300),
+        Pumparounds([15.0, 15.0, 10.0]),
+        Reflux(4.0),
+        Furnace(35.0),
+        Run(600),
+    ];
+    let stripped = vec![
+        Run(1000),
+        Pumparounds([0.0, 0.0, 8.0]),
+        Run(300),
+        Furnace(45.0),
+        Run(600),
+        Valve("steam_valve", 0.8),
+        Run(300),
+        Pumparounds([0.0; 3]),
+        Furnace(58.0),
+        Run(600),
+    ];
+    let steady = vec![Run(2000)];
+    let cold = vec![ColdStartUp];
+    let plants: Vec<(&str, &Vec<Beat>)> = vec![
+        ("crude_unit", &crude),
+        ("crude_column_hot_feed", &steady),
+        ("crude_column_overheated", &steady),
+        ("crude_unit_stripped", &stripped),
+        ("crude_unit_cold", &cold),
+        ("crude_unit_wet", &steady),
+        ("crude_unit_wetter", &steady),
+        ("crude_unit_steam", &steady),
+        ("crude_unit_boiling", &steady),
+    ];
+    for (name, beats) in plants {
+        if !only.is_empty() && !only.iter().any(|o| o == name) {
+            continue;
+        }
+        let mut engine = build(&format!("{dir}/{name}.toml"));
+        let column = engine.graph.find_node("column").expect("a column");
+        let mut ticks: Vec<Tick> = Vec::new();
+        probe::take();
+        let mut tick = |engine: &mut Engine, ticks: &mut Vec<Tick>| {
+            let start = Instant::now();
+            engine.tick().expect("a story's tick");
+            let wall_ns = start.elapsed().as_nanos() as u64;
+            ticks.push(Tick {
+                wall_ns,
+                c: probe::take(),
+            });
+        };
+        for beat in beats {
+            let command = match *beat {
+                Run(n) => {
+                    for _ in 0..n {
+                        tick(&mut engine, &mut ticks);
+                    }
+                    continue;
+                }
+                Reflux(r) => vec![Command::SetRefluxRatio {
+                    node: column,
+                    reflux_ratio: r,
+                }],
+                Pumparounds(d) => (0..3)
+                    .map(|i| Command::SetPumparoundDuty {
+                        node: column,
+                        pumparound: i,
+                        duty: Watt(d[i as usize] * 1e6),
+                    })
+                    .collect(),
+                Furnace(mw) => vec![Command::SetFurnaceDuty {
+                    node: engine.graph.find_node("furnace").unwrap(),
+                    duty: Watt(mw * 1e6),
+                }],
+                Valve(v, o) => vec![Command::SetValveOpening {
+                    node: engine.graph.find_node(v).unwrap(),
+                    opening: o,
+                }],
+                ColdStartUp => {
+                    let furnace = engine.graph.find_node("furnace").unwrap();
+                    for t in 1..=2_400u64 {
+                        if t == 10 {
+                            engine
+                                .apply(Command::SetFurnaceDuty {
+                                    node: furnace,
+                                    duty: Watt(58.0e6),
+                                })
+                                .unwrap();
+                        }
+                        if t == 500 {
+                            for pumparound in 0..3 {
+                                engine
+                                    .apply(Command::SetPumparoundDuty {
+                                        node: column,
+                                        pumparound,
+                                        duty: Watt::ZERO,
+                                    })
+                                    .unwrap();
+                            }
+                        }
+                        if t >= 500 && t % 10 == 0 {
+                            let running = reboiler_w(&engine.snapshot());
+                            if running > 0.0 {
+                                engine
+                                    .apply(Command::SetReboilerDuty {
+                                        node: column,
+                                        duty: Some(Watt((running - 2.5e6).max(0.0))),
+                                    })
+                                    .unwrap();
+                            }
+                        }
+                        tick(&mut engine, &mut ticks);
+                    }
+                    continue;
+                }
+            };
+            for c in command {
+                let _ = engine.apply(c);
+            }
+        }
+        report(name, &ticks);
+        if let Some(d) = &dump {
+            let mut text = String::from(
+                "tick,wall_us,separates,solves,iterations,ev_start,ev_jac,ev_search,ev_other,backward,eval_us,jac_us,fixed_us,separate_us\n",
+            );
+            for (i, t) in ticks.iter().enumerate() {
+                let c = &t.c;
+                text.push_str(&format!(
+                    "{},{:.1},{},{},{},{},{},{},{},{},{:.1},{:.1},{:.1},{:.1}\n",
+                    i + 1,
+                    t.wall_ns as f64 / 1e3,
+                    c.separates,
+                    c.solves,
+                    c.iterations,
+                    c.evals[0],
+                    c.evals[1],
+                    c.evals[2],
+                    c.evals[3],
+                    c.backward,
+                    c.ns[14] as f64 / 1e3,
+                    c.ns[10] as f64 / 1e3,
+                    c.ns[12] as f64 / 1e3,
+                    c.ns[13] as f64 / 1e3
+                ));
+            }
+            std::fs::write(format!("{d}/{name}.csv"), text).unwrap();
+        }
+    }
+}
+
+fn report(name: &str, ticks: &[Tick]) {
+    // Tick 1 (the cold start) apart.
+    let rest = &ticks[1..];
+    let n = rest.len() as f64;
+    let sum = |f: &dyn Fn(&Tick) -> u64| rest.iter().map(f).sum::<u64>() as f64;
+    let max = |f: &dyn Fn(&Tick) -> u64| rest.iter().map(f).max().unwrap_or(0);
+    let evals = |t: &Tick| t.c.evals.iter().sum::<u64>();
+    let wall = sum(&|t| t.wall_ns);
+    println!("== {name}  ({} ticks after the first)", rest.len());
+    println!(
+        "  per tick: separates {:.2}  solves {:.2}  iterations {:.2}  evals {:.1} (start {:.2}, jacobian {:.1}, search {:.2}, other {:.2})  backward {:.2}",
+        sum(&|t| t.c.separates) / n,
+        sum(&|t| t.c.solves) / n,
+        sum(&|t| t.c.iterations) / n,
+        sum(&evals) / n,
+        sum(&|t| t.c.evals[0]) / n,
+        sum(&|t| t.c.evals[1]) / n,
+        sum(&|t| t.c.evals[2]) / n,
+        sum(&|t| t.c.evals[3]) / n,
+        sum(&|t| t.c.backward) / n,
+    );
+    let mut e: Vec<u64> = rest.iter().map(evals).collect();
+    e.sort_unstable();
+    println!(
+        "  evals/tick: median {}  p99 {}  max {}   iterations max {}  solves max {}",
+        e[e.len() / 2],
+        e[((e.len() as f64 * 0.99) as usize).min(e.len() - 1)],
+        e[e.len() - 1],
+        max(&|t| t.c.iterations),
+        max(&|t| t.c.solves)
+    );
+    println!(
+        "  first tick: wall {:.2} ms  solves {}  iterations {}  evals {}  fixed point {:.2} ms",
+        ticks[0].wall_ns as f64 / 1e6,
+        ticks[0].c.solves,
+        ticks[0].c.iterations,
+        evals(&ticks[0]),
+        ticks[0].c.ns[12] as f64 / 1e6
+    );
+    println!(
+        "  wall/tick mean {:.3} ms (loaded machine; shares below are of the wall)",
+        wall / n / 1e6
+    );
+    for (i, s) in SECTIONS.iter().enumerate() {
+        let ns = sum(&|t| t.c.ns[i]);
+        if ns > 0.0 {
+            println!("    {s:28} {:5.1} %", 100.0 * ns / wall);
+        }
+    }
+    // The worst 1 % of ticks by evaluations (deterministic): what they spend.
+    let mut order: Vec<&Tick> = rest.iter().collect();
+    order.sort_by_key(|t| std::cmp::Reverse(evals(t)));
+    let top = &order[..(rest.len() / 100).max(1)];
+    let tw: f64 = top.iter().map(|t| t.wall_ns as f64).sum();
+    let tj: f64 = top.iter().map(|t| t.c.ns[10] as f64).sum();
+    let te: f64 = top.iter().map(|t| t.c.ns[14] as f64).sum();
+    let tf: f64 = top.iter().map(|t| t.c.ns[12] as f64).sum();
+    println!(
+        "  worst 1 % by evals ({} ticks): wall mean {:.2} ms, jacobian {:.1} %, all evals {:.1} %, fixed point {:.1} %",
+        top.len(),
+        tw / top.len() as f64 / 1e6,
+        100.0 * tj / tw,
+        100.0 * te / tw,
+        100.0 * tf / tw
+    );
+}
diff --git a/tools/steptime/src/bin/m69_0_count.rs b/tools/steptime/src/bin/m69_0_count.rs
