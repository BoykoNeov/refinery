diff --git a/crates/solvers/src/probe.rs b/crates/solvers/src/probe.rs
new file mode 100644
index 0000000..c53659f
--- /dev/null
+++ b/crates/solvers/src/probe.rs
@@ -0,0 +1,111 @@
+//! M68.0 probe counters (not for commit): the column solve's work per tick.
+
+use std::cell::RefCell;
+use std::time::Instant;
+
+pub const SECTIONS: [&str; 16] = [
+    "eval:flows+water",
+    "eval:k",
+    "eval:thomas",
+    "eval:summation+normalise",
+    "eval:enthalpy h/H",
+    "eval:condenser",
+    "eval:water enthalpy",
+    "eval:energy+ratios+sat",
+    "eval:draw_states+I7",
+    "newton:dense solve",
+    "newton:jacobian (all)",
+    "newton:solve (all)",
+    "fixed point",
+    "separate (all)",
+    "eval (all)",
+    "spare",
+];
+
+pub const EVAL_START: usize = 0;
+pub const EVAL_JACOBIAN: usize = 1;
+pub const EVAL_SEARCH: usize = 2;
+pub const EVAL_OTHER: usize = 3;
+
+#[derive(Default, Clone, Debug)]
+pub struct Counters {
+    pub separates: u64,
+    pub solves: u64,
+    pub iterations: u64,
+    pub evals: [u64; 4],
+    pub backward: u64,
+    pub ns: [u64; 16],
+}
+
+thread_local! {
+    static COUNTERS: RefCell<Counters> = RefCell::new(Counters::default());
+    static KIND: RefCell<usize> = const { RefCell::new(EVAL_OTHER) };
+}
+
+/// Every counter since the last take, and zeroed.
+pub fn take() -> Counters {
+    COUNTERS.with(|c| std::mem::take(&mut *c.borrow_mut()))
+}
+
+pub(crate) fn with(f: impl FnOnce(&mut Counters)) {
+    COUNTERS.with(|c| f(&mut c.borrow_mut()));
+}
+
+pub(crate) fn set_kind(kind: usize) {
+    KIND.with(|k| *k.borrow_mut() = kind);
+}
+
+pub(crate) fn count_eval() {
+    let kind = KIND.with(|k| *k.borrow());
+    with(|c| c.evals[kind] += 1);
+}
+
+/// Adds the time since `*since` to `section` and restarts the clock.
+pub(crate) fn lap(section: usize, since: &mut Instant) {
+    let now = Instant::now();
+    let ns = (now - *since).as_nanos() as u64;
+    with(|c| c.ns[section] += ns);
+    *since = now;
+}
+
+thread_local! {
+    static FLASH_KEYS: RefCell<std::collections::HashMap<Vec<u64>, u8>> =
+        RefCell::new(std::collections::HashMap::new());
+    static FLASH_ON: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Forgets the tick's flash questions (the driver, every tick).
+pub fn clear_flash_keys() {
+    FLASH_ON.with(|on| on.set(true));
+    FLASH_KEYS.with(|k| k.borrow_mut().clear());
+}
+
+/// One line-flash question, `kind` 1 a density, 2 a settle: counts it as a
+/// repeat of the same kind, or of either, asked before in this tick.
+pub(crate) fn flash_question(kind: u8, fractions: &[f64], liquid_equivalent: f64, pressure: f64) {
+    if !FLASH_ON.with(|on| on.get()) {
+        return;
+    }
+    let mut key: Vec<u64> = fractions.iter().map(|f| f.to_bits()).collect();
+    key.push(liquid_equivalent.to_bits());
+    key.push(pressure.to_bits());
+    let seen = FLASH_KEYS.with(|k| {
+        let mut k = k.borrow_mut();
+        let entry = k.entry(key).or_insert(0);
+        let before = *entry;
+        *entry |= kind;
+        before
+    });
+    if seen != 0 {
+        refinery_core::probe::count(
+            if kind == 1 { "flash: density repeat (any)" } else { "flash: settle repeat (any)" },
+            1,
+        );
+    }
+    if seen & kind != 0 {
+        refinery_core::probe::count(
+            if kind == 1 { "flash: density repeat (same)" } else { "flash: settle repeat (same)" },
+            1,
+        );
+    }
+}
