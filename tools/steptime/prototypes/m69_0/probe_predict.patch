diff --git a/crates/core/src/probe.rs b/crates/core/src/probe.rs
new file mode 100644
index 0000000..c645ce4
--- /dev/null
+++ b/crates/core/src/probe.rs
@@ -0,0 +1,52 @@
+//! M69.0 probe timers (not for commit): named counts and wall time.
+
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::time::Instant;
+
+thread_local! {
+    static TIMERS: RefCell<BTreeMap<&'static str, (u64, u64)>> = RefCell::new(BTreeMap::new());
+}
+
+/// Every timer since the last take: name -> (count, ns), and cleared.
+pub fn take() -> BTreeMap<&'static str, (u64, u64)> {
+    TIMERS.with(|t| std::mem::take(&mut *t.borrow_mut()))
+}
+
+/// Adds one count and the time since `since` to `name`.
+pub fn add(name: &'static str, since: Instant) {
+    let ns = since.elapsed().as_nanos() as u64;
+    TIMERS.with(|t| {
+        let mut t = t.borrow_mut();
+        let e = t.entry(name).or_insert((0, 0));
+        e.0 += 1;
+        e.1 += ns;
+    });
+}
+
+/// Adds `n` to `name`'s count alone.
+pub fn count(name: &'static str, n: u64) {
+    TIMERS.with(|t| {
+        t.borrow_mut().entry(name).or_insert((0, 0)).0 += n;
+    });
+}
+
+thread_local! {
+    static PASSES: RefCell<Vec<(f64, BTreeMap<&'static str, u64>)>> = const { RefCell::new(Vec::new()) };
+    static PASSES_ON: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Marks the end of a pass: its density change and every count so far.
+pub fn mark_pass(change: f64) {
+    if !PASSES_ON.with(|on| on.get()) {
+        return;
+    }
+    let counts = TIMERS.with(|t| t.borrow().iter().map(|(k, v)| (*k, v.0)).collect());
+    PASSES.with(|p| p.borrow_mut().push((change, counts)));
+}
+
+/// Every pass marked since the last take, and cleared.
+pub fn take_passes() -> Vec<(f64, BTreeMap<&'static str, u64>)> {
+    PASSES_ON.with(|on| on.set(true));
+    PASSES.with(|p| std::mem::take(&mut *p.borrow_mut()))
+}
