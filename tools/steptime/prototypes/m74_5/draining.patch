+//! Reference case for a sieve tray's weeping (M74.5, docs/DESIGN.md §79.12):
+//! Hsieh & McNulty's counter-current flow model (*Chem. Eng. Prog.* 89 (1993)
+//! 71, as Coker, *Ludwig's Applied Process Design* Vol. 2, 4th ed., 2010,
+//! §13.44 eqs. 13-54–13-57 reproduces it, pp. 435–436), its weep point moved to
+//! Eduljee's (the user's decision, §79.11), worked by hand:
+//!
+//! ```text
+//!   sieve trays: m = 2.01, C = 0.74;   √J*G + m·√J*L = C,  √J*G read as C·u_h/u_weep
+//!   Z    = h_c^1.5 / D_h^0.5              = 0.05^1.5 / 0.005^0.5 = 0.158114 m
+//!   √J*L = (C/m)·(1 − u_h/u_weep)         = 0.368159 with no gas, 0.184080 at half
+//!   V_L  = J*L·√(g·Z·(ρL − ρG)/ρL)        = 0.135541 × 1.238881 = 0.167919 m/s
+//!   W    = ρL·V_L·A_h                      = 660 × 0.167919 × 3.5157 = 389.634 kg/s
+//! ```
+//!
+//! and a quarter of it, 97.408 kg/s, at half the weep velocity; nothing at or
+//! above it. Pins a wrong constant, a unit slip, a dropped square or root —
+//! not the model's truth, which is its authors' (and on 5 mm holes disagrees
+//! with Eduljee's weep point, §79.11).
+
+use refinery_core::units::*;
+use refinery_solvers::trays::{weep_flow, SieveTray, TrayGeometry, WEEP_LIMIT, WEEP_SLOPE};
+
+/// A section of the holdup plant's middle trays as numbers: 5 mm holes over
+/// 3.5157 m² (15 % of a 7.3 m tray's active area, 22 % downcomers).
+fn tray_geometry() -> TrayGeometry {
+    TrayGeometry {
+        spacing: Meter(0.76),
+        weir_height: Meter(0.05),
+        hole_diameter: Meter(0.005),
+        net_area: SquareMeter(32.65),
+        hole_area: SquareMeter(3.5157),
+        downcomer_area: SquareMeter(2.30),
+        weir_length: Meter(5.0),
+        clearance: Meter(0.045),
+        orifice_coefficient: 0.88,
+        passes: 4,
+    }
+}
+
+/// A tray whose gas runs through its holes at `hole` against Eduljee's weep
+/// velocity `weep` [m/s] — the only two readings the weeping uses.
+fn running_at(hole: f64, weep: f64) -> SieveTray {
+    SieveTray {
+        flow_parameter: 0.0,
+        flood_velocity: MeterPerSec(1.0),
+        net_velocity: MeterPerSec(0.0),
+        hole_velocity: MeterPerSec(hole),
+        weep_velocity: MeterPerSec(weep),
+        weir_crest: Meter(0.0),
+        dry_head: Meter(0.0),
+        residual_head: Meter(0.0),
+        total_head: Meter(0.0),
+        downcomer_loss: Meter(0.0),
+        backup: Meter(0.0),
+        backup_limit: Meter(0.4),
+        pressure_drop: Pascal(0.0),
+    }
+}
+
+fn weeps(hole: f64, weep: f64, clear: f64) -> f64 {
+    weep_flow(
+        &tray_geometry(),
+        &running_at(hole, weep),
+        Meter(clear),
+        KgPerM3(660.0),
+        KgPerM3(6.7),
+    )
+    .value()
+}
+
+#[test]
+fn the_constants_are_hsieh_and_mcnulty_s_for_sieve_trays() {
+    assert_eq!(WEEP_SLOPE, 2.01);
+    assert_eq!(WEEP_LIMIT, 0.74);
+}
+
+#[test]
+fn with_no_gas_a_tray_dumps_at_the_model_s_rate() {
+    let flow = weeps(0.0, 4.0, 0.05);
+    assert!((flow / 389.634 - 1.0).abs() < 1.0e-5, "{flow}");
+}
+
+#[test]
+fn at_half_the_weep_velocity_a_quarter_of_it() {
+    let flow = weeps(2.0, 4.0, 0.05);
+    assert!((flow / 97.408 - 1.0).abs() < 1.0e-5, "{flow}");
+}
+
+#[test]
+fn at_or_above_the_weep_point_nothing_weeps() {
+    assert_eq!(weeps(4.0, 4.0, 0.05), 0.0);
+    assert_eq!(weeps(9.0, 4.0, 0.05), 0.0);
+    // And a deck with no clear liquid weeps nothing at any gas.
+    assert_eq!(weeps(0.0, 4.0, 0.0), 0.0);
+}
+
+/// The rate goes as `Z^0.5`, so as the clear liquid's height to the 0.75:
+/// a deck at a quarter of the height weeps 0.25^0.75 = 0.353553 of it.
+#[test]
+fn a_shallower_deck_weeps_as_its_height_to_three_quarters() {
+    let ratio = weeps(0.0, 4.0, 0.0125) / weeps(0.0, 4.0, 0.05);
+    assert!((ratio - 0.25f64.powf(0.75)).abs() < 1.0e-12, "{ratio}");
+}
