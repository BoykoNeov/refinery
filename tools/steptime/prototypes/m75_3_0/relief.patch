+
+/// M75.3.0 PROBE ONLY — never committed: a relief valve on the column's top,
+/// before the condenser (Kister §9.5, location A), on the engine's gas valve
+/// law, its settings and readings on the ticking thread.
+pub mod probe {
+    use super::*;
+    use std::cell::{Cell, RefCell};
+
+    #[derive(Clone, Debug)]
+    pub struct Relief {
+        /// Kv [m³/h at 1 bar] (the files' `kv`); 0 = no relief.
+        pub kv: f64,
+        /// Set pressure [Pa abs] and accumulation band [Pa] (full lift at
+        /// set + accumulation), back pressure [Pa abs].
+        pub set: f64,
+        pub accumulation: f64,
+        pub back: f64,
+        /// The vapour's γ and the valve's x_T (choke at F_k·x_T).
+        pub gamma: f64,
+        pub x_t: f64,
+        /// Pop: reseat this far [Pa] below set; None: the memoryless curve.
+        pub blowdown: Option<f64>,
+        /// The vent at last tick's pressure (tick-late) instead of the trial's.
+        pub lagged: bool,
+        /// The solve's upper bound [Pa abs] in place of the design pressure.
+        pub upper: f64,
+        /// The condenser's capacity times this (0 = coolant lost).
+        pub capacity_scale: f64,
+    }
+
+    #[derive(Clone, Debug, Default)]
+    pub struct Vent {
+        pub mol_s: f64,
+        pub kg_s: f64,
+        pub masses: Vec<f64>,
+        pub heat_w: f64,
+        pub opening: f64,
+        pub lifted: bool,
+        pub top_vapour_mol_s: f64,
+        pub pressure: f64,
+        pub trials: u32,
+    }
+
+    thread_local! {
+        pub static CONFIG: RefCell<Option<Relief>> = const { RefCell::new(None) };
+        pub static LIFTED: Cell<bool> = const { Cell::new(false) };
+        pub static LAST: RefCell<Option<Vent>> = const { RefCell::new(None) };
+        pub static TRIALS: Cell<u32> = const { Cell::new(0) };
+        pub(crate) static STEP_VENT: RefCell<(Vec<f64>, f64)> = const { RefCell::new((Vec::new(), 0.0)) };
+    }
+
+    pub fn set(config: Option<Relief>) {
+        CONFIG.with(|c| *c.borrow_mut() = config);
+        LIFTED.with(|l| l.set(false));
+        LAST.with(|l| *l.borrow_mut() = None);
+    }
+
+    pub fn last() -> Option<Vent> {
+        LAST.with(|l| l.borrow().clone())
+    }
+
+    /// The vent [mol/s] and the opening at `pressure` [Pa abs]: the gas
+    /// valve law (ISA-75.01, `elements::gas_valve_flow`) through the relief's
+    /// opening (`elements::relief_opening`), the vapour's density ideal at
+    /// last tick's top temperature, its molar mass the drum's liquid's (a
+    /// total condenser's vapour).
+    pub(crate) fn vent_flow(
+        r: &Relief,
+        slate: &Slate,
+        state: &HoldupState,
+        pressure: f64,
+        lifted: bool,
+    ) -> Result<(f64, f64), SimError> {
+        let opening = if lifted {
+            1.0
+        } else {
+            crate::elements::relief_opening(pressure, r.set, r.accumulation)
+        };
+        if opening <= 0.0 || pressure <= r.back {
+            return Ok((0.0, opening));
+        }
+        let x = MoleFractions::from_mass(&state.drum_composition, slate)?;
+        let molar_mass = crate::cascade::molar_mass(slate, x.fractions());
+        let t = state.stage_temperature[0].value();
+        let density = pressure * molar_mass / (R_GAS * t);
+        let cv = r.kv / (3600.0 * 1e5_f64.sqrt()) * opening;
+        let alpha = (density / crate::network::RHO_WATER_REF) / (cv * cv);
+        let x_choke = crate::elements::specific_heat_ratio_factor(r.gamma) * r.x_t;
+        let q = crate::elements::gas_valve_flow(alpha, pressure - r.back, pressure, x_choke, 0.0);
+        Ok((density * q / molar_mass, opening))
+    }
+}
