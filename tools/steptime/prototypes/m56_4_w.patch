@@ -548,3 +548,46 @@ fn is_locked(engine: &Engine) -> bool {
     };
     gas_locked
 }
+
+/// THROWAWAY M56.4: 100–130 °C in 1 °C, cold starts and moves both ways, into
+/// 1.5 and 3 bar, both solvers: the most re-solves and iterations a tick, and
+/// every settled flow written to `M564OUT`.
+#[test]
+fn m564_scratch_sweep() {
+    let Ok(out) = std::env::var("M564OUT") else { return };
+    let mut text = String::new();
+    for destination_bar in [1.5, 3.0] {
+        for solver in SOLVERS {
+            let (mut worst_re, mut worst_it, mut fails) = (0u32, 0u32, 0u32);
+            let mut run = |engine: &mut Engine, label: &str, text: &mut String| {
+                for t in 1..=40 {
+                    if let Err(e) = engine.tick() {
+                        fails += 1;
+                        text.push_str(&format!("FAIL {label} tick {t}: {e}\n"));
+                        return;
+                    }
+                    let s = engine.snapshot();
+                    worst_re = worst_re.max(s.solver.re_solves);
+                    worst_it = worst_it.max(s.solver.iterations);
+                }
+                let s = engine.snapshot();
+                text.push_str(&format!("{label} {:.12e}\n", edge_flow(&s, "discharge")));
+            };
+            for c in 100..=130 {
+                let mut engine = build(&pump_plant(solver, c as f64, destination_bar));
+                run(&mut engine, &format!("{solver} {destination_bar} cold {c}"), &mut text);
+            }
+            let mut engine = build(&pump_plant(solver, 100.0, destination_bar));
+            run(&mut engine, &format!("{solver} {destination_bar} start"), &mut text);
+            let path: Vec<i32> = (101..=130).chain((100..=129).rev()).collect();
+            for (i, &c) in path.iter().enumerate() {
+                warm_supply(&mut engine, "rundown_source", c as f64);
+                run(&mut engine, &format!("{solver} {destination_bar} move{i} {c}"), &mut text);
+            }
+            text.push_str(&format!(
+                "SUMMARY {solver} {destination_bar} bar: worst re-solves {worst_re}, worst iterations {worst_it}, fails {fails}\n"
+            ));
+        }
+    }
+    std::fs::write(out, text).unwrap();
+}
