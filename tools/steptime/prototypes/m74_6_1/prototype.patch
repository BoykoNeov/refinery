+/// Hsieh & McNulty's counter-current flow limit for sieve trays,
+/// `√J*G + m·√J*L = C` ([H] as [L2] §13.44 eqs. 13-54–13-57 reproduces it,
+/// pp. 435–436): `m` [-].
+pub const WEEP_SLOPE: f64 = 2.01;
+/// Its constant `C` [-]: `√J*G` at the weep point, and `m·√J*L` with no gas.
+pub const WEEP_LIMIT: f64 = 0.74;
+
+/// The liquid a sieve tray weeps through its holes [kg/s] (M74.5,
+/// docs/DESIGN.md §79.11–§79.12): Hsieh & McNulty's counter-current flow
+/// model ([H]), its weep point moved to Eduljee's (the user's decision, a
+/// game value — the two disagree on 5 mm holes, §79.11). The model's line,
+///
+/// ```text
+///   √J*G + m·√J*L = C,      J* = u·√(ρ/(g·Z·(ρL − ρG))),   Z = h_c^1.5 / D_h^0.5
+/// ```
+///
+/// (`u` the gas's or the weeping liquid's velocity through the holes, `h_c`
+/// the clear liquid on the deck, `D_h` the holes' diameter; `Z` in metres as
+/// it is in feet from inches, 39.37 × 0.3048 = 12), is kept with `√J*G` read
+/// as `C·u_h/u_weep` — the gas's share of Eduljee's weep velocity
+/// ([`SieveTray::weep_velocity`]). So a tray weeps only below the weep point
+/// the snapshot already reports, nothing above it, and with no gas exactly
+/// Hsieh & McNulty's dump, `√J*L = C/m`. Hsieh & McNulty measured on 3 ft
+/// trays; on an 8 ft one the weeping was over 30 % lower, along the
+/// periphery ([L2] p. 435) — on this game's 6–8.5 m trays the rate is high.
+pub fn weep_flow(
+    geometry: &TrayGeometry,
+    tray: &SieveTray,
+    clear_height: Meter,
+    liquid_density: KgPerM3,
+    vapour_density: KgPerM3,
+) -> KgPerSec {
+    let share = tray.hole_velocity.value() / tray.weep_velocity.value();
+    let height = clear_height.value();
+    if share.is_nan() || share >= 1.0 || height <= 0.0 {
+        return KgPerSec(0.0);
+    }
+    let root = WEEP_LIMIT / WEEP_SLOPE * (1.0 - share.max(0.0));
+    let rho_l = liquid_density.value();
+    let rho_g = vapour_density.value();
+    // Z = h_c^1.5/D_h^0.5 ([L2] eq. 13-54); J*L = V_L·√(ρL/(g·Z·(ρL − ρG)))
+    // (eq. 13-55), V_L through the holes.
+    let z = height.powf(1.5) / geometry.hole_diameter.value().sqrt();
+    let velocity = root * root * (G * z * (rho_l - rho_g) / rho_l).sqrt();
+    KgPerSec(rho_l * velocity * geometry.hole_area.value())
+}
+
