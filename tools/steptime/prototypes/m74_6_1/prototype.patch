+//! M74.6.0's probe switches (the start from empty) — PROBE ONLY, never
+//! shipped. Each is read from the environment once per process, except the
+//! total-reflux switch, which a driver flips per thread between ticks.
+//!
+//! - `M74_6_0_STEEL=1`: each stage's steel a heat store, its mass from the
+//!   trays' geometry (M74.0's game estimate: a 15 mm shell over the tray
+//!   spacing and a deck at 60 kg/m²; the base a 15 mm shell around its
+//!   volume and a head), carbon steel's heat capacity 500 J/(kg·K).
+//! - `M74_6_0_DRAIN=1`: the held-back draining (C29) on; off, nothing weeps.
+//! - `M74_6_0_EMPTY=1`: a column that holds liquid starts empty: its first
+//!   tick's settled solve kept for the level loops' references, the state
+//!   then emptied, every stage and the drum at `M74_6_0_AMBIENT_C` (20 °C).
+
+use std::cell::Cell;
+use std::sync::OnceLock;
+
+fn flag(name: &str) -> bool {
+    std::env::var(name).is_ok_and(|v| v == "1")
+}
+
+/// Steel on.
+pub(crate) fn steel() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| flag("M74_6_0_STEEL"))
+}
+
+/// The draining on.
+pub(crate) fn drain() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| flag("M74_6_0_DRAIN"))
+}
+
+/// Start empty.
+pub(crate) fn empty() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| flag("M74_6_0_EMPTY"))
+}
+
+/// The steel's and an empty column's starting temperature [K].
+pub(crate) fn ambient_k() -> f64 {
+    static T: OnceLock<f64> = OnceLock::new();
+    *T.get_or_init(|| {
+        std::env::var("M74_6_0_AMBIENT_C")
+            .ok()
+            .map_or(20.0, |v| v.parse().unwrap_or(20.0))
+            + 273.15
+    })
+}
+
+/// M74.6.1: every stage's steel mass times `M74_6_1_STEEL_SCALE` (default 1).
+pub(crate) fn steel_scale() -> f64 {
+    static S: OnceLock<f64> = OnceLock::new();
+    *S.get_or_init(|| {
+        std::env::var("M74_6_1_STEEL_SCALE")
+            .ok()
+            .map_or(1.0, |v| v.parse().unwrap_or(1.0))
+    })
+}
+
+/// Carbon steel's heat capacity [J/(kg·K)] — about 0.11–0.12 Btu/(lb·°F)
+/// near ambient, rising when hot: a game value, 500.
+pub(crate) const STEEL_CP: f64 = 500.0;
+/// The shell's thickness [m] and its steel's density [kg/m³], and a deck's
+/// steel per area [kg/m²] (M74.0's game estimate, `startup.py`).
+pub(crate) const SHELL_M: f64 = 0.015;
+pub(crate) const STEEL_DENSITY: f64 = 7850.0;
+pub(crate) const DECK_KG_M2: f64 = 60.0;
+
+thread_local! {
+    static TOTAL_REFLUX: Cell<bool> = const { Cell::new(false) };
+}
+
+/// The total-reflux start mode on this thread: the distillate and the side
+/// draws shut, the drum's level held by the reflux alone (Kister §12.8).
+pub fn set_total_reflux(on: bool) {
+    TOTAL_REFLUX.with(|c| c.set(on));
+}
+
+pub(crate) fn total_reflux() -> bool {
+    TOTAL_REFLUX.with(Cell::get)
+}
