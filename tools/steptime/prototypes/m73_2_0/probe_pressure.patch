+/// M73.2.0 PROBE: stage `j`'s (zero-based) pressure, the column's own when no
+/// probe profile is set.
+pub(crate) fn probe_stage_pressure(j: usize, pressure: Pascal) -> Pascal {
+    PROBE_STAGE_PRESSURES.with(|p| match &*p.borrow() {
+        Some(v) if j < v.len() => Pascal(v[j]),
+        _ => pressure,
+    })
+}
