+thread_local! {
+    /// M73.2.0 PROBE: each tray's pressure drop at 100 % of jet flood when it
+    /// is past it (its own otherwise), from the last `column_trays` [Pa].
+    pub(crate) static PROBE_CAPPED: std::cell::RefCell<Vec<f64>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// M73.2.0 PROBE: the tray's pressure drop with its vapour cut to where it
+/// stands at exactly 100 % of jet flood, the liquid as it is (bisection: the
+/// flood fraction rises with the vapour, the flow parameter falling with it).
+pub(crate) fn capped_drop(geometry: &TrayGeometry, load: &TrayLoad) -> f64 {
+    let fraction = |scale: f64| {
+        let scaled = TrayLoad {
+            vapour: KgPerSec(load.vapour.value() * scale),
+            ..*load
+        };
+        let tray = sieve_tray(geometry, &scaled);
+        (tray.net_velocity.value() / tray.flood_velocity.value(), tray.pressure_drop.value())
+    };
+    let (flood, drop) = fraction(1.0);
+    if !(flood > 1.0) {
+        return drop;
+    }
+    let (mut low, mut high) = (0.0, 1.0);
+    for _ in 0..60 {
+        let middle = 0.5 * (low + high);
+        if fraction(middle).0 > 1.0 {
+            high = middle;
+        } else {
+            low = middle;
+        }
+    }
+    fraction(low).1
+}
