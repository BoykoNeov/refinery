+
+fn probe_feed_quality(
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    feed: &[f64],
+    bubble: Kelvin,
+    pass: &ColumnPass<'_>,
+) -> Result<f64, SimError> {
+    let latent = mixture_dh_vap(slate, thermo, feed, bubble)?;
+    let heat_capacity = mixture_molar_cp(slate, feed);
+    let linear_q = 1.0 - heat_capacity * (pass.temperature.value() - bubble.value()) / latent;
+    let t_feed = pass.temperature.value();
+    let mut q = linear_q;
+    if std::env::var("PROBE_MODE").as_deref() == Ok("flash") && t_feed > bubble.value() {
+        let z = MoleFractions::from_amounts(feed)?;
+        let excess = |t: f64| -> Result<(f64, f64), SimError> {
+            let r = crate::flash::flash_isothermal(&z, slate, thermo, Kelvin(t), pass.pressure)?;
+            let lam = mixture_dh_vap(slate, thermo, r.vapour.fractions(), Kelvin(t))?;
+            let beta_energy = heat_capacity * (t_feed - t) / lam;
+            Ok((r.vapour_fraction - beta_energy, beta_energy))
+        };
+        let (mut lo, mut hi) = (bubble.value(), t_feed);
+        for _ in 0..200 { let mid = 0.5 * (lo + hi); if excess(mid)?.0 < 0.0 { lo = mid } else { hi = mid } }
+        let (_, beta) = excess(0.5 * (lo + hi))?;
+        q = 1.0 - beta;
+        eprintln!("PROBE flash: T_star={:.2}K beta={beta:.4} linear_q={linear_q:.4}", 0.5 * (lo + hi));
+    }
+    eprintln!("PROBE bubble={:.3}K feedT={:.3}K lambda={latent:.1} cp={heat_capacity:.2} window_per_unit_q={:.2}K", bubble.value(), pass.temperature.value(), latent / heat_capacity);
+    Ok(q)
+}
