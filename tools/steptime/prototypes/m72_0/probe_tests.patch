+#[test]
+fn probe_m72_cut_back_with_loops() {
+    for reflux in [0.6, 0.4, 0.3, 0.2, 0.1] {
+        let mut engine = engine();
+        let column = id(&engine, "column");
+        run(&mut engine, 1000).expect("settles");
+        engine
+            .apply(Command::SetRefluxRatio { node: column, reflux_ratio: reflux })
+            .unwrap();
+        match run(&mut engine, 1000) {
+            Ok(s) => {
+                let c = node(&s, "column");
+                println!(
+                    "PROBE reflux {reflux}: ran at {:?}, cut {:?}",
+                    c.column_operation.as_ref().map(|o| o.reflux_ratio),
+                    c.column_draws_cut_back
+                );
+            }
+            Err(e) => println!("PROBE reflux {reflux}: HALT {}", &e[..e.len().min(300)]),
+        }
+    }
+}
