@@ -0,0 +1,241 @@
+//! M72.5 probe (not for commit): the column's solves on the ticks after each
+//! key press, per Jacobian candidate (`PROBE_JAC` = fd | broyden | chord<k>).
+//!
+//! cargo run --release --bin m72_5_count -- <scenarios dir> <out dir> [plant ...]
+//!   prints each key press's first ticks solve by solve, and a summary;
+//!   writes <out dir>/<plant>.json — the snapshots after each key press and at
+//!   each beat's end — for `compare.py` to set one candidate against another.
+
+use refinery_core::snapshot::Command;
+use refinery_core::units::{Kelvin, KgPerSec, Watt};
+use refinery_core::Engine;
+use refinery_solvers::probe::{self, Counters};
+use std::time::Instant;
+
+#[derive(Clone, Copy)]
+enum Beat {
+    Run(u32),
+    Reflux(f64),
+    Furnace(f64),
+    LoopFlow(u32, f64),
+    LoopReturn(u32, f64),
+}
+
+fn build(path: &str) -> Engine {
+    let src = std::fs::read_to_string(path).unwrap_or_else(|e| panic!("{path}: {e}"));
+    let file = refinery_scenarios::load_str(&src).expect("parse");
+    refinery_scenarios::build_engine(&file).expect("build")
+}
+
+fn label(beat: Beat) -> String {
+    match beat {
+        Beat::Run(n) => format!("run {n}"),
+        Beat::Reflux(r) => format!("reflux -> {r}"),
+        Beat::Furnace(mw) => format!("furnace -> {mw} MW"),
+        Beat::LoopFlow(l, f) => format!("loop {} flow -> {f} kg/s", l + 1),
+        Beat::LoopReturn(l, c) => format!("loop {} return -> {c} C", l + 1),
+    }
+}
+
+fn evals(c: &Counters) -> u64 {
+    c.evals.iter().sum()
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let dir = args[1].clone();
+    let out = args[2].clone();
+    let only: Vec<String> = args[3..].to_vec();
+    let method = std::env::var("PROBE_JAC").unwrap_or_else(|_| "fd".into());
+    use Beat::*;
+    let common = vec![
+        Run(1000),
+        Reflux(2.0),
+        Run(300),
+        Reflux(4.0),
+        Run(300),
+        Furnace(35.0),
+        Run(300),
+        Furnace(20.0),
+        Run(300),
+        Reflux(6.0),
+        Run(300),
+        Reflux(4.0),
+        Run(300),
+    ];
+    let mut loops = common.clone();
+    loops.extend([
+        LoopFlow(0, 120.0),
+        Run(300),
+        LoopFlow(0, 85.0),
+        Run(300),
+        LoopReturn(1, 180.0),
+        Run(300),
+        LoopReturn(1, 215.0),
+        Run(300),
+        LoopFlow(2, 40.0),
+        Run(300),
+        LoopFlow(2, 65.0),
+        Run(300),
+    ]);
+    let plants: Vec<(&str, &Vec<Beat>)> =
+        vec![("crude_unit", &common), ("crude_unit_loops", &loops)];
+    for (name, beats) in plants {
+        if !only.is_empty() && !only.iter().any(|o| o == name) {
+            continue;
+        }
+        let mut engine = build(&format!("{dir}/{name}.toml"));
+        let column = engine.graph.find_node("column").expect("a column");
+        let furnace = engine.graph.find_node("furnace").expect("a furnace");
+        println!("== {name}  [{method}]");
+        probe::take();
+        let mut walls: Vec<f64> = Vec::new();
+        let mut all_evals = 0u64;
+        let mut keep: Vec<serde_json::Value> = Vec::new();
+        let mut since_press = u32::MAX;
+        let mut press = String::new();
+        let mut worst: Vec<(f64, String)> = Vec::new();
+        let mut most = (0u64, 0usize, String::new());
+        for beat in beats {
+            let command = match *beat {
+                Run(n) => {
+                    for _ in 0..n {
+                        let start = Instant::now();
+                        let result = engine.tick();
+                        let wall = start.elapsed().as_secs_f64() * 1e3;
