+                                worst.push((wall, press.clone()));
+                                keep.push(serde_json::json!({
+                                    "at": format!("after {press}"),
+                                    "snapshot": serde_json::to_value(engine.snapshot()).unwrap(),
+                                }));
+                            }
+                        }
+                    }
+                    keep.push(serde_json::json!({
+                        "at": format!("end of {} ticks", walls.len()),
+                        "snapshot": serde_json::to_value(engine.snapshot()).unwrap(),
+                    }));
+                    continue;
+                }
+                Reflux(r) => Command::SetRefluxRatio {
+                    node: column,
+                    reflux_ratio: r,
+                },
+                Furnace(mw) => Command::SetFurnaceDuty {
+                    node: furnace,
+                    duty: Watt(mw * 1e6),
+                },
+                LoopFlow(l, f) => Command::SetLoopFlow {
+                    node: column,
+                    pumparound_loop: l,
+                    flow: KgPerSec(f),
+                },
+                LoopReturn(l, c) => Command::SetLoopReturnTemperature {
+                    node: column,
+                    pumparound_loop: l,
+                    temperature: Kelvin(c + 273.15),
+                },
+            };
+            press = label(*beat);
+            println!("  -- {press}");
+            engine.apply(command).expect("a command");
+            since_press = 0;
+        }
+        let mut sorted = walls[1..].to_vec();
+        sorted.sort_by(|a, b| a.total_cmp(b));
+        println!(
+            "  most evals after tick 1: {} at tick {} ({})
+  summary: {} ticks, evals {all_evals}, wall median {:.3} ms, p99 {:.3}, max {:.2}; key-press ticks: {}",
+            most.0,
+            most.1,
+            most.2,
+            walls.len(),
+            sorted[sorted.len() / 2],
+            sorted[sorted.len() * 99 / 100],
+            sorted[sorted.len() - 1],
+            worst
+                .iter()
+                .map(|(w, p)| format!("{p} {w:.1}"))
+                .collect::<Vec<_>>()
+                .join("; ")
+        );
+        std::fs::write(
+            format!("{out}/{name}.json"),
+            serde_json::to_string(&keep).unwrap(),
+        )
+        .unwrap();
+    }
+}
+
+fn print_tick(k: u32, wall: f64, c: &Counters) {
+    println!(
+        "    tick +{k}: {wall:.2} ms  separates {}  warm failures {}  cold paths {}  late floor {}  evals {} (start {}, jacobian {}, search {}, other {})  eval time {:.2} ms",
+        c.separates,
+        c.warm_failures,
+        c.cold_paths,
+        c.late_floor,
+        evals(c),
+        c.evals[0],
+        c.evals[1],
+        c.evals[2],
+        c.evals[3],
+        c.eval_ns as f64 / 1e6
+    );
+    for row in &c.solves {
+        let halvings: u32 = row.steps.iter().map(|s| s.halvings).sum();
+        let capped = row.steps.iter().filter(|s| s.max_dt >= 24.999).count();
+        let steps: Vec<String> = row
+            .steps
+            .iter()
+            .map(|s| {
+                format!(
+                    "{}{:.2}/{:.0}K/{:.1e}",
+                    if s.fresh { "" } else { "~" },
+                    s.scale,
+                    s.max_dt,
+                    s.norm
+                )
+            })
+            .collect();
+        println!(
+            "      {:9} n={} {} it {} fd {} evals {}+{}+{} back {} halvings {} at-25K {} {:.2} ms {}",
+            row.spec,
+            row.unknowns,
+            if row.ok { "ok " } else { "ERR" },
+            row.iterations,
+            row.fd_jacobians,
+            row.evals[0],
+            row.evals[1],
+            row.evals[2],
+            row.backward,
+            halvings,
+            capped,
+            row.ns as f64 / 1e6,
+            if row.ok { "" } else { &row.reason }
+        );
+        if row.iterations > 1 {
+            println!("        steps (scale/max dT/norm, ~ = reused): {}", steps.join(" "));
+        }
+    }
+}
