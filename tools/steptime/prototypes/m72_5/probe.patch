--- /dev/null
+++ b/crates/solvers/src/probe.rs
@@ -0,0 +1,108 @@
+//! M72.5 probe counters (not for commit): each column solve on a tick, and the
+//! Jacobian candidate the solve runs on (`PROBE_JAC`).
+
+use std::cell::RefCell;
+use std::sync::OnceLock;
+
+pub const EVAL_START: usize = 0;
+pub const EVAL_JACOBIAN: usize = 1;
+pub const EVAL_SEARCH: usize = 2;
+pub const EVAL_OTHER: usize = 3;
+
+/// The Jacobian a Newton step is taken on.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Method {
+    /// Today's: forward differences every iteration.
+    Fd,
+    /// Forward differences on iteration 1 and on a refresh; Broyden's rank-1
+    /// ("good") update in between, scaled by the unknowns' sizes.
+    Broyden,
+    /// One forward-difference Jacobian reused for up to `k` iterations.
+    Chord(u32),
+}
+
+/// `PROBE_JAC` = fd | broyden | chord<k>; `PROBE_RATIO` the residual drop past
+/// which a reused Jacobian is refreshed (default 0.5).
+pub fn method() -> Method {
+    static METHOD: OnceLock<Method> = OnceLock::new();
+    *METHOD.get_or_init(|| match std::env::var("PROBE_JAC").as_deref() {
+        Ok("broyden") => Method::Broyden,
+        Ok(s) if s.starts_with("chord") => Method::Chord(s[5..].parse().unwrap_or(3)),
+        _ => Method::Fd,
+    })
+}
+
+pub fn refresh_ratio() -> f64 {
+    static RATIO: OnceLock<f64> = OnceLock::new();
+    *RATIO.get_or_init(|| {
+        std::env::var("PROBE_RATIO")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0.5)
+    })
+}
+
+#[derive(Default, Clone, Debug)]
+pub struct Step {
+    pub scale: f64,
+    pub halvings: u32,
+    pub max_dt: f64,
+    pub norm: f64,
+    pub fresh: bool,
+}
+
+#[derive(Default, Clone, Debug)]
+pub struct SolveRow {
+    pub spec: String,
+    pub unknowns: usize,
+    pub ok: bool,
+    pub iterations: u32,
+    pub fd_jacobians: u32,
+    pub evals: [u64; 4],
+    pub backward: u64,
+    pub ns: u64,
+    pub steps: Vec<Step>,
+    pub reason: String,
+}
+
+#[derive(Default, Clone, Debug)]
+pub struct Counters {
+    pub separates: u64,
+    pub warm_failures: u64,
+    pub cold_paths: u64,
+    pub late_floor: u64,
+    pub evals: [u64; 4],
+    pub eval_ns: u64,
+    pub fixed_point_ns: u64,
+    pub solves: Vec<SolveRow>,
+}
+
+thread_local! {
+    static COUNTERS: RefCell<Counters> = RefCell::new(Counters::default());
+    static KIND: RefCell<usize> = const { RefCell::new(EVAL_OTHER) };
+}
+
+/// Every counter since the last take, and zeroed.
+pub fn take() -> Counters {
+    COUNTERS.with(|c| std::mem::take(&mut *c.borrow_mut()))
+}
+
+pub(crate) fn with<R>(f: impl FnOnce(&mut Counters) -> R) -> R {
+    COUNTERS.with(|c| f(&mut c.borrow_mut()))
+}
+
+pub(crate) fn set_kind(kind: usize) {
+    KIND.with(|k| *k.borrow_mut() = kind);
+}
+
+/// One evaluation of `ns`, charged to the open solve and the tick.
+pub(crate) fn count_eval(ns: u64) {
+    let kind = KIND.with(|k| *k.borrow());
+    with(|c| {
+        c.evals[kind] += 1;
+        c.eval_ns += ns;
+        if let Some(row) = c.solves.last_mut() {
+            row.evals[kind] += 1;
+        }
+    });
+}
