--- /dev/null
+++ b/crates/solvers/src/probe.rs
@@ -0,0 +1,89 @@
+//! THROWAWAY M67.0 probe state: a side draw cut back where its tray runs short
+//! (ledger C17), and counters. Per thread — the corpus runs plants on threads.
+use std::cell::{Cell, RefCell};
+
+thread_local! {
+    /// The liquid a cut-back draw leaves flowing below its tray, as a share of
+    /// the feed's moles [-]; negative is the shipped engine (no cutting back).
+    pub static LIQUID_MIN_SHARE: Cell<f64> = const { Cell::new(-1.0) };
+    /// A cut-back draw is released once its share would exceed the declared
+    /// one by this much [-].
+    pub static RELEASE_MARGIN: Cell<f64> = const { Cell::new(1.0e-6) };
+    pub static COUNTS: RefCell<Counts> = RefCell::new(Counts::new());
+    /// The cut-back draws the last converged solve on this thread ran with —
+    /// the probe's stand-in for a field on the carried profile.
+    pub static LAST_SHORT: RefCell<Vec<usize>> = const { RefCell::new(Vec::new()) };
+    /// `M67_TRACE` read once.
+    pub static TRACE: Cell<bool> = const { Cell::new(false) };
+}
+
+#[derive(Clone, Debug)]
+pub struct Counts {
+    /// Newton solves (each call of the wet-set solve).
+    pub solves: u64,
+    pub failed: u64,
+    /// Failed solves whose last iterate has a side draw's tray liquid at or
+    /// below 1 % of the feed.
+    pub failed_dry_draw: u64,
+    /// Cold fixed-point warm-ups that refused.
+    pub cold_refused: u64,
+    /// Over converged solves: the lowest liquid leaving a side draw's tray, a
+    /// share of the feed's moles, and on which stage (one-based).
+    pub min_liquid_share: f64,
+    pub min_liquid_stage: usize,
+    /// Converged solves with at least one draw cut back; the most at once; the
+    /// lowest share of its declared rate a cut-back draw ran at.
+    pub short_solves: u64,
+    pub max_short: usize,
+    pub min_of_declared: f64,
+    /// Calls of the cut-back wrapper and the solves they took beyond the first.
+    pub wrapper_calls: u64,
+    pub wrapper_extra: u64,
+    /// The last converged solve: each side draw's share of its declared rate,
+    /// and the lowest liquid under a side draw (a share of the feed's moles).
+    pub last_of_declared: Vec<f64>,
+    pub last_min_liquid: f64,
+}
+
+impl Counts {
+    pub const fn new() -> Self {
+        Self {
+            solves: 0,
+            failed: 0,
+            failed_dry_draw: 0,
+            cold_refused: 0,
+            min_liquid_share: f64::INFINITY,
+            min_liquid_stage: 0,
+            short_solves: 0,
+            max_short: 0,
+            min_of_declared: f64::INFINITY,
+            wrapper_calls: 0,
+            wrapper_extra: 0,
+            last_of_declared: Vec::new(),
+            last_min_liquid: f64::INFINITY,
+        }
+    }
+}
+
+impl Default for Counts {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// This thread's counters, reset.
+pub fn take() -> Counts {
+    COUNTS.with(|c| std::mem::take(&mut *c.borrow_mut()))
+}
+
+/// This thread's settings from `M67_LIQUID_MIN` and `M67_RELEASE_MARGIN`.
+pub fn set_from_env() {
+    if let Ok(v) = std::env::var("M67_LIQUID_MIN") {
+        LIQUID_MIN_SHARE.with(|c| c.set(v.parse().unwrap()));
+    }
+    TRACE.with(|c| c.set(std::env::var("M67_TRACE").is_ok()));
+    LAST_SHORT.with(|c| c.borrow_mut().clear());
+    if let Ok(v) = std::env::var("M67_RELEASE_MARGIN") {
+        RELEASE_MARGIN.with(|c| c.set(v.parse().unwrap()));
+    }
+}
