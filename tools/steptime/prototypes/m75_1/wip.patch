@@ -0,0 +1,50 @@
+//! M75.1 — a column's condenser as a limit, and the pressure that rises past
+//! it (docs/DESIGN.md §80.1): the holdup plant (`crude_unit_holdup.toml`,
+//! untouched) with its steel and a `condenser_limit` declared inline.
+
+use crate::column_empty::{
+    engine_of, holdup, holdup_with, reading, run, set_total_reflux, state, Books,
+};
+
+/// The holdup plant with its steel and the condenser `limit` (the keys
+/// inside `condenser_limit = { … }`).
+fn with_limit(limit: &str) -> String {
+    let steel = holdup_with(", steel = \"derived\"");
+    let line = "holdup = { drum_m3 = 18.7, base_m3 = 115.4, reboiler = \"held\", steel = \"derived\" }";
+    assert!(steel.contains(line));
+    steel.replace(line, &format!("{line}\ncondenser_limit = {{ {limit} }}"))
+}
+
+#[test]
+fn probe_m75_1() {
+    let mut engine = engine_of(&with_limit("margin = 0.05, coolant_c = 35.0, overhead_m3 = 100.0")).unwrap();
+    let books = Books::of(&engine);
+    run(&mut engine, 100);
+    eprintln!("UA {:?} cond {:?}", state(&engine).condenser_ua, holdup(&engine).condenser);
+    set_total_reflux(&mut engine, true).unwrap();
+    let mut worst = (0.0f64, 0.0f64);
+    for tick in 0..3000 {
+        let before = state(&engine);
+        engine.tick().unwrap_or_else(|e| panic!("tick {tick}: {e}"));
+        let (mass, heat) = books.close(&engine, &before);
+        worst = (worst.0.max(mass.abs()), worst.1.max(heat.abs()));
+        if tick % 100 == 0 {
+            let s = engine.snapshot();
+            let r = reading(&s);
+            let c = r.condenser.unwrap();
+            let duty = s.nodes.iter().find(|n| n.name == "column").unwrap().column_duty.unwrap();
+            eprintln!(
+                "t={:>5.0}s P {:.4} bar cap {:.2} MW duty {:.2} MW atcap {} drum {:.3} books {:.2e} kg/s {:.2e} W",
+                tick as f64 * 0.1,
+                c.pressure_pa / 1e5,
+                c.capacity_w / 1e6,
+                duty.condenser_w / 1e6,
+                c.at_capacity,
+                r.drum_level,
+                mass,
+                heat
+            );
+        }
+    }
+    eprintln!("worst books {:.2e} kg/s {:.2e} W", worst.0, worst.1);
+}
