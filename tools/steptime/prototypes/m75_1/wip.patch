+/// A condenser's `UA` [W/K] from the duty its column settled on (M75.1,
+/// docs/DESIGN.md §80.1): `UA = Q₀·(1 + margin) / (T_b − T_coolant)` — so at
+/// the set pressure, with the condensate leaving at its bubble point `T_b`
+/// (a total condenser), it condenses the settled duty with its margin to
+/// spare. The coolant taken at one temperature along the tubes (a GAME VALUE
+/// of the plant's), the driving difference the condensate's.
+fn condenser_ua(
+    condenser: &ColumnCondenser,
+    settled_duty: Watt,
+    condensate: Kelvin,
+) -> Result<WattPerKelvin, SimError> {
+    let difference = condensate.value() - condenser.coolant.value();
+    if difference <= 0.0 || settled_duty.value() <= 0.0 {
+        return Err(SimError::Numerical(format!(
+            "the column's condenser cannot be sized: it settled on {:.3} MW with its \
+             condensate at {:.1} °C and its coolant at {:.1} °C — a condenser condenses \
+             something, onto a coolant colder than its condensate (docs/DESIGN.md §80.1).",
+            settled_duty.value() / 1.0e6,
+            condensate.value() - 273.15,
+            condenser.coolant.value() - 273.15,
+        )));
+    }
+    Ok(WattPerKelvin(
+        settled_duty.value() * (1.0 + condenser.margin) / difference,
+    ))
+}
+
+/// The pressure a column with a declared condenser runs at next tick, and
+/// its condenser's reading this tick (M75.1, docs/DESIGN.md §80.1).
+///
+/// The condenser's capacity at a pressure `P`: `C(P) = UA·(T_b(x, P) −
+/// T_coolant)`, `x` the drum's liquid (the condensate), `T_b` its bubble
+/// point. The vapour it cannot condense fills the overhead volume `V` at
+/// the top's temperature `T` (ideal gas): `dP/dt = (R·T/V)·(Q − C(P))/λ`,
+/// `Q` the duty the tick's step condensed, `λ` the condensate's molar latent
+/// heat. One linearly implicit Euler step on `dt` (`C` linear in `P` about
+/// this tick's, `dC/dP = UA / (dP_b/dT)` at the bubble point,
+/// Clausius–Clapeyron's slope read off the thermo's bubble pressure), so it
+/// is stable on any overhead volume. Then the control: the condenser floods
+/// its tubes to hold the set pressure, never lower; and no higher than the
+/// design pressure. The step itself condenses all it is sent at the tick's
+/// pressure, so the books are the step's: the uncondensed vapour is a
+/// pressure, not a stock.
+#[allow(clippy::too_many_arguments)]
+fn next_column_pressure(
+    slate: &Slate,
+    thermo: &dyn ThermoModel,
+    condenser: &ColumnCondenser,
+    ua: WattPerKelvin,
+    pressure: Pascal,
+    duty: Watt,
+    drum: &Composition,
+    top: Kelvin,
+    tick: Seconds,
+) -> Result<(Pascal, CondenserReading), SimError> {
+    let x = MoleFractions::from_mass(drum, slate)?;
+    let what = "the column's condensate";
+    let capacity_of =
+        |bubble: Kelvin| ua.value() * (bubble.value() - condenser.coolant.value()).max(0.0);
+    let bubble = bubble_temperature(slate, thermo, &x, pressure, what)?;
+    let capacity = capacity_of(bubble);
+    let at_set = if pressure == condenser.set_pressure {
+        capacity
+    } else {
+        capacity_of(bubble_temperature(
+            slate,
+            thermo,
+            &x,
+            condenser.set_pressure,
+            what,
+        )?)
+    };
+    // Clausius–Clapeyron's slope, dP_b/dT at the bubble point, central.
+    const DT: f64 = 0.01;
+    let rise = (thermo
+        .bubble_pressure(slate, drum, Kelvin(bubble.value() + DT))?
+        .value()
+        - thermo
+            .bubble_pressure(slate, drum, Kelvin(bubble.value() - DT))?
+            .value())
+        / (2.0 * DT);
+    let slope = if capacity > 0.0 && rise > 0.0 {
+        ua.value() / rise
+    } else {
+        0.0
+    };
+    let latent = mixture_dh_vap(slate, thermo, x.fractions(), top)?;
+    if latent.is_nan() || latent <= 0.0 {
+        return Err(SimError::Numerical(format!(
+            "the column's condensate reads a latent heat of {latent:.4e} J/mol at {:.1} K: its \
+             overhead pressure cannot be followed (docs/DESIGN.md §80.1).",
+            top.value()
+        )));
+    }
+    // Ideal gas in the overhead: dP per joule left uncondensed.
+    let rate = R_GAS * top.value() / (condenser.overhead_volume.value() * latent);
+    let dt = tick.value();
+    let change = dt * rate * (duty.value() - capacity) / (1.0 + dt * rate * slope);
+    let next = (pressure.value() + change)
+        .max(condenser.set_pressure.value())
+        .min(condenser.design_pressure.value());
+    if !next.is_finite() {
+        return Err(SimError::Numerical(format!(
+            "the column's overhead pressure came to {next} Pa (docs/DESIGN.md §80.1)."
+        )));
+    }
+    Ok((
+        Pascal(next),
+        CondenserReading {
+            pressure,
+            set_pressure: condenser.set_pressure,
+            capacity: Watt(capacity),
+            at_capacity: duty.value() > at_set,
+            at_design: pressure.value() >= condenser.design_pressure.value(),
+        },
+    ))
+}
