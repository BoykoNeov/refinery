diff --git a/tools/steptime/src/bin/m70_0_step.rs b/tools/steptime/src/bin/m70_0_step.rs
new file mode 100644
index 0000000..ab269d7
--- /dev/null
+++ b/tools/steptime/src/bin/m70_0_step.rs
@@ -0,0 +1,143 @@
+//! M70.0 probe: a plant held, its furnace stepped, every tick timed, its
+//! solves counted and each density re-check's largest move named.
+//!
+//! m70_0_step <scenario.toml> <label> <hold ticks> <furnace MW> <after ticks>
+//!   OUT=<dir>  <label>.csv (a row per tick) and <label>_t<tick>.json snapshots
+
+use refinery_core::graph::NodeId;
+use refinery_core::snapshot::Command;
+use refinery_core::units::Watt;
+use std::time::Instant;
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let (path, label) = (&a[1], &a[2]);
+    let hold: u64 = a[3].parse().unwrap();
+    let mw: f64 = a[4].parse().unwrap();
+    let after: u64 = a[5].parse().unwrap();
+    let out = std::env::var("OUT").unwrap_or_else(|_| ".".into());
+    let src = std::fs::read_to_string(path).unwrap();
+    let file = refinery_scenarios::load_str(&src).expect("parse");
+    let mut engine = refinery_scenarios::build_engine(&file).expect("build");
+    let furnace = engine.graph.find_node("furnace").unwrap();
+    let snaps = [hold, hold + 60, hold + 600, hold + after];
+    let mut csv = String::from("tick,wall_us,re_solves,changes,nodes\n");
+    refinery_core::probe::take();
+    let mut walls = Vec::new();
+    let mut solves = Vec::new();
+    if let Ok(pre) = std::env::var("PRE_MW") {
+        engine
+            .apply(Command::SetFurnaceDuty {
+                node: furnace,
+                duty: Watt(pre.parse::<f64>().unwrap() * 1e6),
+            })
+            .unwrap();
+    }
+    let cold = std::env::var("COLD").is_ok();
+    let column = engine.graph.find_node("column").unwrap();
+    for t in 1..=hold + after {
+        // The cold start-up of `crude_unit_cold_reference.rs` (M68.0's driver).
+        if cold {
+            if t == 10 {
+                engine
+                    .apply(Command::SetFurnaceDuty {
+                        node: furnace,
+                        duty: Watt(58.0e6),
+                    })
+                    .unwrap();
+            }
+            if t == 500 {
+                for pumparound in 0..3 {
+                    engine
+                        .apply(Command::SetPumparoundDuty {
+                            node: column,
+                            pumparound,
+                            duty: Watt::ZERO,
+                        })
+                        .unwrap();
+                }
+            }
+            if t >= 500 && t % 10 == 0 {
+                let s = engine.snapshot();
+                let running = s
+                    .nodes
+                    .iter()
+                    .find(|n| n.name == "column")
+                    .unwrap()
+                    .column_duty
+                    .as_ref()
+                    .unwrap()
+                    .reboiler_w;
+                if running > 0.0 {
+                    engine
+                        .apply(Command::SetReboilerDuty {
+                            node: column,
+                            duty: Some(Watt((running - 2.5e6).max(0.0))),
+                        })
+                        .unwrap();
+                }
+            }
+        }
+        if !cold && t == hold + 1 {
+            engine
+                .apply(Command::SetFurnaceDuty {
+                    node: furnace,
+                    duty: Watt(mw * 1e6),
+                })
+                .unwrap();
+        }
+        let start = Instant::now();
+        engine.tick().unwrap_or_else(|e| panic!("tick {t}: {e}"));
+        let wall = start.elapsed().as_nanos() as f64 / 1e3;
+        let checks = refinery_core::probe::take();
+        let snap = engine.snapshot();
+        let changes: Vec<String> = checks.iter().map(|c| format!("{:.2e}", c.1)).collect();
+        let nodes: Vec<String> = checks
+            .iter()
+            .map(|c| {
+                if c.2 == usize::MAX {
+                    "-".to_string()
+                } else {
+                    engine.graph.node(NodeId(c.2 as u32)).name.clone()
+                }
+            })
+            .collect();
+        csv.push_str(&format!(
+            "{t},{wall:.1},{},{},{}\n",
+            snap.solver.re_solves,
+            changes.join(";"),
+            nodes.join(";")
+        ));
+        if t > hold {
+            walls.push(wall);
+            solves.push(1 + snap.solver.re_solves);
+        }
+        if snaps.contains(&t) {
+            std::fs::write(
+                format!("{out}/{label}_t{t}.json"),
+                serde_json::to_string(&snap).unwrap(),
+            )
+            .unwrap();
+        }
+    }
+    std::fs::write(format!("{out}/{label}.csv"), csv).unwrap();
+    let median = |v: &[f64]| {
+        let mut v = v.to_vec();
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        v[v.len() / 2]
+    };
+    let mean_solves = |s: &[u32]| s.iter().sum::<u32>() as f64 / s.len() as f64;
+    let n = walls.len().min(600);
+    println!(
+        "{label}: after the step, first 60 ticks median {:.2} ms, solves {:.2}; first 600 median {:.2} ms, solves {:.2}, over 2.5 ms {}; ticks {}..{} median {:.2} ms solves {:.2}",
+        median(&walls[..60]) / 1e3,
+        mean_solves(&solves[..60]),
+        median(&walls[..n]) / 1e3,
+        mean_solves(&solves[..n]),
+        walls[..n].iter().filter(|w| **w > 2500.0).count(),
+        n,
+        walls.len(),
+        median(&walls[n..]) / 1e3,
+        mean_solves(&solves[n..]),
+    );
+}
