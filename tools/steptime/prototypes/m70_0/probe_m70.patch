--- /dev/null
+++ b/crates/core/src/probe.rs
@@ -0,0 +1,10 @@
+//! M70.0 probe (throwaway): each re-check's largest density move and the node
+//! that set it.
+use std::sync::Mutex;
+
+/// (pass, change, node index) per density check of the tick.
+pub static CHECKS: Mutex<Vec<(u32, f64, usize)>> = Mutex::new(Vec::new());
+
+pub fn take() -> Vec<(u32, f64, usize)> {
+    std::mem::take(&mut *CHECKS.lock().unwrap())
+}
