; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format documentation:
; https://docs.godotengine.org/en/stable/tutorials/editor/project_settings.html
;
; This project is the Godot 4 frontend host for the Refinery simulator.
; The simulation itself lives in the Rust workspace (crates/*) and is surfaced
; here by the refinery-godot-ext GDExtension — see refinery.gdextension, which
; also explains why nothing loads until that crate has been built.
;
; The 4.3 this file used to declare was the version it was created under, not
; a version anything was tested against. It says 4.7 because that is the Godot
; the extension was built and demonstrated against (M6.2), and because
; `compatibility_minimum` in refinery.gdextension and the `api-4-7` feature in
; crates/godot-ext/Cargo.toml both name the same number. CONSEQUENCE, stated
; rather than discovered: this project now requires Godot >= 4.7. Moving to an
; older editor means moving all three together.

config_version=5

[application]

config/name="Refinery"
config/description="Godot 4 frontend host for the Refinery simulator. Loads the GDAI MCP editor plugin and the refinery-godot-ext GDExtension (build it first: cargo build -p refinery-godot-ext --features godot)."
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://demo/menu.tscn"

[display]

; Every screen draws at fixed coordinates for a 1152 x 648 page (the reactor's
; for 1440 x 810, which it asks for itself: demo/screen.gd). `canvas_items`
; scales that page to the window, so a screen fills a large monitor instead of
; sitting in its corner; `expand` gives a wider window more page rather than
; black bars (each screen paints its background to the window's edge).
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdai-mcp-plugin-godot/plugin.cfg")
